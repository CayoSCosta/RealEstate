@model Imobi.MVC.ViewModels.UnidadeViewModel

@{
    ViewData["Title"] = "Excluir Unidade";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="py-4">
    <div class="alert alert-danger shadow-sm">
        <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Atenção!</h4>
        <p>Você está prestes a excluir a unidade <strong>@Model.Tipo</strong> do empreendimento <strong>@(Model.Empreendimento?.Nome)</strong>.</p>
        <hr>
        <p class="mb-0">Esta ação não pode ser desfeita e removerá também as fotos vinculadas.</p>
    </div>

    <div class="card shadow-sm mb-4 border-danger">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Dados da Unidade</h5>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Tipo</dt>
                <dd class="col-sm-9">@Model.Tipo</dd>

                <dt class="col-sm-3">Área</dt>
                <dd class="col-sm-9">@Model.AreaConstruida m²</dd>

                <dt class="col-sm-3">Valor</dt>
                <dd class="col-sm-9">@Model.Valor?.ToString("C")</dd>
            </dl>
        </div>
    </div>

    @if (Model.Imagens != null && Model.Imagens.Any())
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h6 class="mb-0 text-muted">Imagens que serão excluídas</h6>
            </div>
            <div class="card-body">
                <div class="d-flex overflow-auto gap-3 pb-2">
                    @foreach (var img in Model.Imagens)
                    {
                        <div style="min-width: 150px; width: 150px;">
                            <img src="@img.Base64" class="rounded shadow-sm border" style="width: 100%; height: 100px; object-fit: cover;" />
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <div class="d-flex justify-content-end gap-2">
            <a asp-controller="Empreendimento" asp-action="Details" asp-route-id="@Model.EmpreendimentoId" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-danger px-4 fw-bold">
                <i class="bi bi-trash-fill me-1"></i> Confirmar Exclusão
            </button>
        </div>
    </form>
</div>