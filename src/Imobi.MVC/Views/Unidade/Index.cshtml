@using Imobi.Models.Empreendimento
@model IEnumerable<Unidade>

@{
    ViewData["Title"] = "Unidades";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_Loader")

@* <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"> *@

<h3 class="mb-4">Unidades</h3>

<p>
    <a asp-action="Create" class="btn btn-success">Novo</a>
</p>

<table class="table table-hover shadow-sm">
    <thead class="table-light">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Status)</th>
            <th>@Html.DisplayNameFor(model => model.Tipo)</th>
            <th>@Html.DisplayNameFor(model => model.Dormitorios)</th>
            <th>@Html.DisplayNameFor(model => model.Suites)</th>
            <th>@Html.DisplayNameFor(model => model.Banheiros)</th>
            <th>@Html.DisplayNameFor(model => model.Vagas)</th>
            <th>@Html.DisplayNameFor(model => model.AreaConstruida)</th>
            <th>@Html.DisplayNameFor(model => model.Valor)</th>
            <th>@Html.DisplayNameFor(model => model.Empreendimento)</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" disabled @(item.Status ? "checked" : "") />
                    </div>
                </td>
                <td>@Html.DisplayFor(modelItem => item.Tipo)</td>
                <td>@Html.DisplayFor(modelItem => item.Dormitorios)</td>
                <td>@Html.DisplayFor(modelItem => item.Suites)</td>
                <td>@Html.DisplayFor(modelItem => item.Banheiros)</td>
                <td>@Html.DisplayFor(modelItem => item.Vagas)</td>
                <td>@item.AreaConstruida.ToString("N2")</td>
                <td>@item.Valor?.ToString("C")</td>
                <td>@item.Empreendimento?.Nome</td>
                <td>
                    <div class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Detalhes">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
