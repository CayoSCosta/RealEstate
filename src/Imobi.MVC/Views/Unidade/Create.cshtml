@using Imobi.MVC.ViewModels
@model UnidadeViewModel

@{
    ViewData["Title"] = "Criar Unidade";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_Loader")

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Cadastrar Unidade</h3>
    </div>

    <form asp-action="Create" id="form-create" enctype="multipart/form-data" class="needs-validation" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card card-panel mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3 text-primary">Dados da Unidade</h5>
                <div class="row g-3">

                    @if (Model.EmpreendimentoId != Guid.Empty || !string.IsNullOrEmpty(Model.Empreendimento.Nome))
                    {
                        <div class="col-12">
                            <label class="form-label text-muted small">Empreendimento Vinculado</label>
                            <h4 class="text-dark mb-0">@(Model.Empreendimento.Nome ?? ViewBag.EmpreendimentoNome)</h4>
                            <input type="hidden" asp-for="EmpreendimentoId" />
                        </div>
                    }
                    else
                    {
                        <div class="col-12">
                            <label asp-for="EmpreendimentoId" class="form-label fw-bold">Selecione o Empreendimento</label>
                            <select asp-for="EmpreendimentoId" class="form-select" asp-items="ViewBag.Empreendimentos">
                                <option value="">-- Selecione --</option>
                            </select>
                            <span asp-validation-for="EmpreendimentoId" class="text-danger"></span>
                        </div>
                    }

                    <div class="col-md-4">
                        <label asp-for="Tipo" class="form-label fw-semibold"></label>
                        <input asp-for="Tipo" class="form-control" placeholder="Ex: Apartamento, Studio..." />
                        <span asp-validation-for="Tipo" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Valor" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">R$</span>
                            <input asp-for="Valor" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Valor" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="AreaConstruida" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="AreaConstruida" class="form-control" type="number" />
                            <span class="input-group-text">m²</span>
                        </div>
                        <span asp-validation-for="AreaConstruida" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Dormitorios" class="form-label fw-semibold"></label>
                        <input asp-for="Dormitorios" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Dormitorios" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Suites" class="form-label fw-semibold"></label>
                        <input asp-for="Suites" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Suites" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Banheiros" class="form-label fw-semibold"></label>
                        <input asp-for="Banheiros" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Banheiros" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Vagas" class="form-label fw-semibold"></label>
                        <input asp-for="Vagas" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Vagas" class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <div class="form-check form-switch pt-2">
                            <input asp-for="Status" class="form-check-input" type="checkbox" checked />
                            <label class="form-check-label" asp-for="Status">Unidade Ativa / Disponível</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-panel mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title text-primary mb-0">Galeria</h5>
                    <label for="imagensUpload" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-cloud-upload"></i> Adicionar Imagens
                    </label>
                </div>

                <input type="file" id="imagensUpload" name="ImagensUpload" class="d-none" multiple accept="image/*" />

                <div id="previewContainer" class="border rounded p-3 bg-light text-center">
                    <p class="text-muted mb-0 small">Nenhuma imagem selecionada</p>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 pb-5">
            <a asp-action="Index" class="btn btn-light border">Cancelar</a>
            <button type="submit" class="btn btn-primary px-4">Salvar Cadastro</button>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}