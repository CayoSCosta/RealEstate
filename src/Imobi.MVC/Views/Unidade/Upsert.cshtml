@using Imobi.MVC.ViewModels.Util
@using Imobi.Domain.Enum
@model PagedResultViewModel<Imobi.MVC.ViewModels.UnidadeViewModel>

@{
    ViewData["Title"] = "Gestão de Unidades";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_Loader")

<div class="main-container">
    <div class="container-fluid">
        @* Cabeçalho de Ações *@
        <div class="d-flex justify-content-between align-items-end mb-5">
            <div>
                <h2 class="fw-bold text-dark mb-1">Unidades</h2>
                <p class="text-muted mb-0">Gerencie o estoque de unidades e disponibilidades.</p>
            </div>
            <a asp-action="Create" class="btn btn-dark px-4 py-2 shadow-sm d-flex align-items-center" style="border-radius: 10px;">
                <i class="bi bi-plus-lg me-2"></i> Nova Unidade
            </a>
        </div>

        <form id="filterForm" method="get" asp-action="Index">
            <input type="hidden" name="PageNumber" id="pageNumber" value="@Model.PageNumber" />
            <input type="hidden" name="SortBy" id="sortBy" value="@ViewBag.CurrentSort" />

            <div class="table-responsive">
                <table class="table table-modern align-middle">
                    <thead>
                        <tr>
                            <th style="width: 10%">Status</th>
                            <th style="width: 15%">Tipo</th>
                            <th style="width: 10%">Vagas</th>
                            <th style="width: 15%">Área (m²)</th>
                            <th style="width: 15%">Valor</th>
                            <th style="width: 20%">Empreendimento</th>
                            <th style="width: 15%">Registro</th>
                            <th class="text-center">Ações</th>
                        </tr>
                        <tr class="filter-row">
                            <th>
                                @await Html.PartialAsync("_FilterField", new FilterFieldConfig {
                                Index = 0, PropertyName = "Status", Label = "Status",
                                                                Type = typeof(bool), Operator = FilterOperator.Equals
                                                                })
                            </th>
                            <th>
                                @await Html.PartialAsync("_FilterField", new FilterFieldConfig {
                                                                Index = 1, PropertyName = "Tipo", Label = "Tipo",
                                                                Type = typeof(string), Operator = FilterOperator.Contains
                                                                })
                            </th>
                            <th>
                                @await Html.PartialAsync("_FilterField", new FilterFieldConfig {
                                                                Index = 2, PropertyName = "Vagas", Label = "Mín",
                                                                Type = typeof(int), Operator = FilterOperator.GreaterThan
                                                                })
                            </th>
                            <th>
                                @await Html.PartialAsync("_FilterField", new FilterFieldConfig {
                                                                Index = 3, PropertyName = "AreaConstruida", Label = "Min m²",
                                                                Type = typeof(decimal), Operator = FilterOperator.GreaterThan
                                                                })
                            </th>
                            <th>
                                @await Html.PartialAsync("_FilterField", new FilterFieldConfig {
                                                                Index = 4, PropertyName = "Valor", Label = "Min R$",
                                                                Type = typeof(decimal), Operator = FilterOperator.GreaterThan
                                                                })
                            </th>
                            <th>
                                @await Html.PartialAsync("_FilterField", new FilterFieldConfig {
                                                                Index = 5, PropertyName = "Empreendimento.Nome", Label = "Projeto",
                                                                Type = typeof(string), Operator = FilterOperator.Contains
                                                                })
                            </th>
                            <th>
                                @await Html.PartialAsync("_FilterField", new FilterFieldConfig {
                                                                Index = 6, PropertyName = "CriadoEm", Label = "Data",
                                                                Type = typeof(DateTime), Operator = FilterOperator.Between
                                                                })
                            </th>
                            <th class="text-center">
                                <div class="d-flex gap-1 justify-content-center">
                                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                                        <i class="bi bi-search"></i>
                                    </button>
                                    <a asp-action="Index" class="btn btn-light btn-sm rounded-pill border" id="btnReset">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </a>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <span class="badge @(item.Status ? "badge-soft-success" : "badge-soft-secondary") rounded-pill">
                                            @(item.Status ? "Disponível" : "Vendido")
                                        </span>
                                    </td>
                                    <td class="text-dark fw-medium">@item.Tipo</td>
                                    <td><i class="bi bi-car-front me-1 text-muted"></i> @item.Vagas</td>
                                    <td>@item.AreaConstruida.ToString("N2") <span class="text-muted small">m²</span></td>
                                    <td class="fw-bold text-primary">@item.Valor?.ToString("C")</td>
                                    <td class="text-muted">@item.Empreendimento.Nome</td>
                                    <td>
                                        <div class="text-muted small">
                                            <i class="bi bi-calendar3 me-1"></i> @item.CriadoEm.ToString("dd/MM/yyyy")
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex gap-3 justify-content-center">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="text-primary fs-5" title="Editar"><i class="bi bi-pencil-square"></i></a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="text-info fs-5" title="Detalhes"><i class="bi bi-eye"></i></a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger fs-5" title="Excluir"><i class="bi bi-trash3"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    Nenhuma unidade encontrada.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>

        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#filterForm').on('submit', function() {
                if(window.Loading) window.Loading.show("Buscando unidades...");
            });

            $('#btnReset').on('click', function() {
                if(window.Loading) window.Loading.show("Limpando filtros...");
            });

            $('.page-item-link').on('click', function (e) {
                e.preventDefault();
                var page = $(this).data('page');
                if (page) {
                    $('#pageNumber').val(page);
                    $('#filterForm').submit();
                }
            });
        });
    </script>
}