@model Imobi.MVC.ViewModels.UnidadeViewModel

@{
    ViewData["Title"] = "Detalhes da Unidade";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">@Model.Tipo</h3>
            @if (Model.Empreendimento != null)
            {
                <small class="text-muted">No empreendimento: <strong>@Model.Empreendimento.Nome</strong></small>
            }
        </div>
        <div class="d-flex gap-2">
            <span class="badge @(Model.Status ? "bg-success" : "bg-danger") fs-6 align-self-center">
                @(Model.Status ? "Disponível" : "Indisponível")
            </span>
        </div>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body p-4">
            <h5 class="text-primary fw-bold border-bottom pb-2 mb-4">Características</h5>

            <div class="row g-4 text-center">
                <div class="col-6 col-md-2 border-end">
                    <h2 class="fw-bold text-dark mb-0">@Model.AreaConstruida<small class="fs-6 text-muted">m²</small></h2>
                    <small class="text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Área</small>
                </div>
                <div class="col-6 col-md-2 border-end">
                    <h2 class="fw-bold text-dark mb-0">@Model.Dormitorios</h2>
                    <small class="text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Quartos</small>
                </div>
                <div class="col-6 col-md-2 border-end">
                    <h2 class="fw-bold text-dark mb-0">@Model.Suites</h2>
                    <small class="text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Suítes</small>
                </div>
                <div class="col-6 col-md-2 border-end">
                    <h2 class="fw-bold text-dark mb-0">@Model.Vagas</h2>
                    <small class="text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Vagas</small>
                </div>
                <div class="col-12 col-md-4">
                    <h2 class="fw-bold text-success mb-0">@Model.Valor?.ToString("C")</h2>
                    <small class="text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Valor de Venda</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 text-primary fw-bold">Fotos da Unidade</h5>
        </div>
        <div class="card-body">
            @if (Model.Imagens != null && Model.Imagens.Any())
            {
                <div class="row g-2">
                    @foreach (var img in Model.Imagens.OrderBy(x => x.Ordem))
                    {
                        <div class="col-6 col-md-3">
                            <div class="position-relative shadow-sm rounded overflow-hidden">
                                <span class="badge bg-dark bg-opacity-75 position-absolute top-0 start-0 m-1 small">
                                    # @img.Ordem
                                </span>
                                @if (img.Tipo != null)
                                {
                                    <span class="badge bg-primary bg-opacity-75 position-absolute bottom-0 end-0 m-1 small">
                                        @img.Tipo
                                    </span>
                                }
                                <img src="@img.Base64"
                                     class="img-fluid"
                                     style="height: 200px; width: 100%; object-fit: cover;"
                                     alt="@img.Legenda"
                                     title="@img.Legenda" />
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted text-center py-5">Nenhuma foto cadastrada para esta unidade.</p>
            }
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 fixed-bottom-bar p-3 bg-white border-top shadow-lg" style="position: sticky; bottom: 0; z-index: 100;">
        <a asp-controller="Empreendimento" asp-action="Details" asp-route-id="@Model.EmpreendimentoId" class="btn btn-outline-secondary px-4">
            Voltar ao Empreendimento
        </a>
        <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-primary px-4 fw-bold">
            <i class="bi bi-pencil me-1"></i> Editar Unidade
        </a>
    </div>
</div>