@using Imobi.MVC.Models.ViewModels.MeuPerfil
@using Imobi.MVC.Models.Components
@model MeuPerfilViewModel
@{
    ViewData["Title"] = "Meu Perfil";
}

@await Html.PartialAsync("_Loader")

<h3 class="mb-4">Meu Perfil</h3>

<form asp-action="Index" method="post" id="form-perfil">

    <input type="hidden" asp-for="FotoBase64" id="inputFotoBase64" />

    <div class="row mb-5">
        <div class="col-12 text-center">
            <div class="profile-avatar-wrapper">
                <img id="avatarPreview"
                     src="@(!string.IsNullOrEmpty(Model.FotoAtual) ? Model.FotoAtual : "/img/default-avatar.png")"
                     class="rounded-circle profile-avatar"
                     alt="Foto de Perfil"
                     onerror="this.src='https://ui-avatars.com/api/?name=@Model.Nome&background=random'" />

                <button type="button" class="btn btn-primary btn-edit-avatar shadow"
                        data-bs-toggle="modal" data-bs-target="#modalPerfil" title="Alterar foto">
                    <i class="bi bi-camera-fill"></i>
                </button>
            </div>
            <p class="text-muted mt-2 small">Clique na câmera para alterar</p>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <details open>
            <summary class="card-header bg-light">
                <span class="summary-title fw-bold text-primary">Dados pessoais</span>
            </summary>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nome" class="form-label fw-semibold"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SobreNome" class="form-label fw-semibold"></label>
                        <input asp-for="SobreNome" class="form-control" />
                        <span asp-validation-for="SobreNome" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EmailSecundario" class="form-label fw-semibold"></label>
                        <input asp-for="EmailSecundario" class="form-control" />
                    </div>
                </div>
            </div>
        </details>
    </div>

    <div class="card shadow-sm mb-4">
        <details>
            <summary class="card-header bg-light">
                <span class="summary-title fw-bold text-danger">Segurança</span>
            </summary>
            <div class="card-body">
                <div class="alert alert-light border mb-3">
                    <small class="text-muted"><i class="bi bi-info-circle me-1"></i> Preencha apenas se desejar alterar sua senha.</small>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Senha Atual</label>
                        <input name="SenhaAtual" type="password" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nova Senha</label>
                        <input name="NovaSenha" type="password" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Confirmar Nova Senha</label>
                        <input name="ConfirmarNovaSenha" type="password" class="form-control" />
                    </div>
                </div>
                <button formaction="/Perfil/AlterarSenha" formmethod="post" class="btn btn-outline-warning mt-3">
                    <i class="bi bi-key"></i> Alterar senha
                </button>
            </div>
        </details>
    </div>

    <div class="text-end pb-5">
        <button type="submit" class="btn btn-success px-4 py-2">
            <i class="bi bi-check-circle me-1"></i> Salvar alterações
        </button>
    </div>
</form>

@await Html.PartialAsync("_ModalImageCropper", new ModalCropperOptions
{
    ModalId = "modalPerfil",
    Title = "Alterar Foto de Perfil",
    EnableAvatars = true
})

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    <script src="~/js/components/image-cropper.js"></script>
    <script src="~/js/pages/meu-perfil.js"></script>
}
}