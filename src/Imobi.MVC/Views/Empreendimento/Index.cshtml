@using Imobi.Models.Empreendimento
@model IEnumerable<Empreendimento>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_Loader")

<h3 class="mb-4">Empreendimentos</h3>

<p>
    <a asp-action="Create" class="btn btn-success">Novo</a>
</p>

<table class="table table-hover shadow-sm">
    <thead class="table-light">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nome)</th>
            <th>@Html.DisplayNameFor(model => model.Endereco.Bairro)</th>
            <th>@Html.DisplayNameFor(model => model.Endereco.Logradouro)</th>
            <th>@Html.DisplayNameFor(model => model.Estagio)</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                <td>@Html.DisplayFor(modelItem => item.Endereco.Bairro)</td>
                <td>@($"{item.Endereco.Logradouro} nº{item.Endereco.Numero}")</td>
                <td>@Html.DisplayFor(modelItem => item.Estagio)</td>
                <td>
                    <div class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Detalhes">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
