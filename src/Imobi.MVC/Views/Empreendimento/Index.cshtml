@using Imobi.MVC.ViewModels.Util
@using Imobi.Domain.Enum
@model PagedResultViewModel<Imobi.MVC.ViewModels.EmpreendimentoViewModel>

@{
    ViewData["Title"] = "Gestão de Empreendimentos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_Loader")

<div class="main-container">
    <div class="container-fluid">
        @* Header *@
        <div class="d-flex justify-content-between align-items-end mb-5">
            <div>
                <h2 class="fw-bold text-dark mb-1">Empreendimentos</h2>
                <p class="text-muted mb-0">Controle e monitoramento de lançamentos imobiliários.</p>
            </div>
            <a asp-action="Upsert" class="btn btn-dark px-4 py-2 shadow-sm d-flex align-items-center" style="border-radius: 10px;">
                <i class="bi bi-plus-lg me-2"></i> Adicionar Novo
            </a>
        </div>

        <form id="filterForm" method="get" asp-action="Index">
            <input type="hidden" name="PageNumber" id="pageNumber" value="@Model.PageNumber" />
            <input type="hidden" name="SortBy" id="sortBy" value="@ViewBag.CurrentSort" />

            <div class="table-responsive">
                <table class="table table-modern align-middle">
                    <thead>
                        <tr>
                            <th style="width: 35%">Nome do Projeto</th>
                            <th style="width: 15%">Status</th>
                            <th style="width: 15%">Estágio</th>
                            <th style="width: 20%">Data de Registro</th>
                            <th class="text-center">Operações</th>
                        </tr>
                        @* Linha de Filtros Dinâmicos *@
                        <tr class="filter-row">
                            <th>
                                @await Html.PartialAsync("_FilterField", new FilterFieldConfig {
                                Index = 0, PropertyName = "Nome", Label = "Buscar nome",
                                                                Type = typeof(string), Operator = FilterOperator.Contains
                                                                })
                            </th>
                            <th>
                                @await Html.PartialAsync("_FilterField", new FilterFieldConfig {
                                                                Index = 1, PropertyName = "Status", Label = "Status",
                                                                Type = typeof(bool), Operator = FilterOperator.Equals
                                                                })
                            </th>
                            <th>
                                @await Html.PartialAsync("_FilterField", new FilterFieldConfig {
                                                                Index = 2, PropertyName = "Estagio", Label = "Fase",
                                                                Type = typeof(EstagioObraEnum), Operator = FilterOperator.Equals
                                                                })
                            </th>
                            <th>
                                @await Html.PartialAsync("_FilterField", new FilterFieldConfig {
                                                                Index = 3, PropertyName = "CriadoEm", Label = "Período",
                                                                Type = typeof(DateTime), Operator = FilterOperator.Between
                                                                })
                            </th>
                            <th class="text-center">
                                <div class="d-flex gap-2 justify-content-center">
                                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                                        <i class="bi bi-search me-1"></i> Filtrar
                                    </button>
                                    <a asp-action="Index" class="btn btn-light btn-sm rounded-pill border" id="btnReset">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </a>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@item.Nome</td>
                                    <td>
                                        <span class="badge @(item.Status ? "badge-soft-success" : "badge-soft-secondary")">
                                            @(item.Status ? "Ativo" : "Inativo")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge badge-soft-primary">@item.Estagio</span>
                                    </td>
                                    <td>
                                        <div class="text-muted small">
                                            <i class="bi bi-calendar3 me-1"></i> @item.CriadoEm.ToString("dd/MM/yyyy")
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex gap-3 justify-content-center">
                                            <a asp-action="Upsert" asp-route-id="@item.Id" class="text-primary fs-5" title="Editar"><i class="bi bi-pencil-square"></i></a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="text-info fs-5" title="Ver Detalhes"><i class="bi bi-eye"></i></a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger fs-5" title="Excluir"><i class="bi bi-trash3"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </form>

        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // Loader no submit do filtro
            $('#filterForm').on('submit', function() {
                if(window.Loading) window.Loading.show("Buscando dados...");
            });

            // Loader no reset
            $('#btnReset').on('click', function() {
                if(window.Loading) window.Loading.show("Limpando filtros...");
            });

            // Paginação
            $('.page-item-link').on('click', function (e) {
                e.preventDefault();
                var page = $(this).data('page');
                if (page) {
                    $('#pageNumber').val(page);
                    $('#filterForm').submit();
                }
            });
        });
    </script>
}