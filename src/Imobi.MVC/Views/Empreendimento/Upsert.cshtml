@using Imobi.MVC.Models.Components
@using Imobi.Domain.Enum
@using Imobi.MVC.ViewModels.Util
@using Imobi.MVC.ViewModels.Validator.Base
@model Imobi.MVC.ViewModels.EmpreendimentoViewModel

@{
    var isEdicao = Model.Id != Guid.Empty;
    ViewData["Title"] = isEdicao ? "Editar Empreendimento" : "Novo Empreendimento";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var listaOpcoes = Html.GetEnumSelectList<TipoImagemEmpreendimentoEnum>();
}

@await Html.PartialAsync("_Loader")

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-dark fw-bold">@(isEdicao ? "Editar" : "Cadastrar") Empreendimento</h3>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Voltar para a Lista</a>
    </div>

    <form asp-action="Upsert" id="form-upsert" enctype="multipart/form-data" class="needs-validation" novalidate>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="EnderecoId" />
        <input type="hidden" asp-for="Endereco.Id" />

        <div class="card shadow-sm mb-4 border-0">
            <details open>
                <summary class="card-header bg-light fw-bold text-primary d-flex align-items-center justify-content-between" style="cursor:pointer">
                    <span><i class="bi bi-info-circle me-2"></i> Informações do Empreendimento</span>
                    <i class="bi bi-chevron-down text-muted small"></i>
                </summary>
                <div class="card-body row g-3">
                    <div class="col-md-9">
                        <label asp-for="Nome" class="form-label fw-semibold"></label>
                        <input asp-for="Nome" class="form-control"
                               data-validate="title"
                               data-min="@ValidationLimits.TitleMin"
                               data-max="@ValidationLimits.TitleMax" required />
                        <span asp-validation-for="Nome" class="text-danger small" data-valmsg-for="Nome"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Status" class="form-label fw-semibold d-block">Situação</label>
                        <div class="form-check form-switch custom-switch-lg">
                            <input asp-for="Status" class="form-check-input" type="checkbox" role="switch" id="chkStatus" />
                            <label class="form-check-label fw-bold ms-2" for="chkStatus" id="labelStatus">
                                @(Model.Status ? "Ativo" : "Inativo")
                            </label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Estagio" class="form-label fw-semibold"></label>
                        <select asp-for="Estagio" class="form-select" asp-items="Html.GetEnumSelectList<EstagioObraEnum>()" required>
                            <option value="">Selecione...</option>
                        </select>
                        <span asp-validation-for="Estagio" class="text-danger small" data-valmsg-for="Estagio"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Sobre" class="form-label fw-semibold"></label>
                        <textarea asp-for="Sobre" class="form-control" rows="3"
                                  data-validate="textbox"
                                  data-max="@ValidationLimits.TextBoxMax"></textarea>
                        <span asp-validation-for="Sobre" class="text-danger small" data-valmsg-for="Sobre"></span>
                    </div>
                </div>
            </details>
        </div>

        <div class="card shadow-sm mb-4 border-0">
            <details open>
                <summary class="card-header bg-light fw-bold text-primary d-flex align-items-center justify-content-between" style="cursor:pointer">
                    <span><i class="bi bi-geo-alt me-2"></i> Localização</span>
                    <i class="bi bi-chevron-down text-muted small"></i>
                </summary>
                <div class="card-body row g-3">
                    <div class="col-md-3">
                        <label asp-for="Endereco.Cep" class="form-label fw-semibold"></label>
                        <input asp-for="Endereco.Cep" class="form-control" id="Endereco_Cep" data-validate="cep" required />
                        <span asp-validation-for="Endereco.Cep" class="text-danger small" data-valmsg-for="Endereco.Cep"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Endereco.Logradouro" class="form-label fw-semibold"></label>
                        <input asp-for="Endereco.Logradouro" class="form-control bg-light" id="Endereco_Logradouro" readonly />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Endereco.Numero" class="form-label fw-semibold"></label>
                        <input asp-for="Endereco.Numero" class="form-control" id="Endereco_Numero"
                               data-validate="number"
                               data-max="@ValidationLimits.NumberMaxDigits" required />
                        <span asp-validation-for="Endereco.Numero" class="text-danger small" data-valmsg-for="Endereco.Numero"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Endereco.Bairro" class="form-label fw-semibold"></label>
                        <input asp-for="Endereco.Bairro" class="form-control bg-light" id="Endereco_Bairro" readonly />
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Endereco.Cidade" class="form-label fw-semibold"></label>
                        <input asp-for="Endereco.Cidade" class="form-control bg-light" id="Endereco_Cidade" readonly />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Endereco.Uf" class="form-label fw-semibold"></label>
                        <input asp-for="Endereco.Uf" class="form-control bg-light" id="Endereco_Uf" readonly />
                    </div>
                    <div class="col-12">
                        <label asp-for="Endereco.Complemento" class="form-label fw-semibold"></label>
                        <input asp-for="Endereco.Complemento" class="form-control"
                               data-validate="text"
                               data-max="@ValidationLimits.TextMax" required />
                        <span asp-validation-for="Endereco.Complemento" class="text-danger small" data-valmsg-for="Endereco.Complemento"></span>
                    </div>
                </div>
            </details>
        </div>

        @await Html.PartialAsync("_GaleriaUpload", new GaleriaConfigViewModel {
        Titulo = "Galeria do Empreendimento",
                ContainerId = "imagensExistentesContainer",
                ModalId = "modalEmpreendimento",
                Imagens = Model.Imagens ?? new(),
                OpcoesTipo = listaOpcoes
                })

        @if (isEdicao)
        {
            <div class="card shadow-sm mb-4 border-0">
                <details open>
                    <summary class="card-header bg-light fw-bold text-primary d-flex align-items-center justify-content-between" style="cursor:pointer">
                        <span><i class="bi bi-houses me-2"></i> Unidades Vinculadas</span>
                        <i class="bi bi-chevron-down text-muted small"></i>
                    </summary>
                    <div class="card-body p-0">
                        <div class="d-flex justify-content-end p-3 bg-white border-bottom">
                            <a class="btn btn-sm btn-primary" asp-controller="Unidade" asp-action="Upsert" asp-route-empreendimentoId="@Model.Id">
                                <i class="bi bi-plus-lg"></i> Adicionar Unidade
                            </a>
                        </div>
                        @if (Model.Unidades != null && Model.Unidades.Any())
                        {
                            @await Html.PartialAsync("_tabelaUnidade", Model.Unidades)
                        }
                    </div>
                </details>
            </div>
        }

        <div class="d-flex justify-content-end gap-2 pb-5 mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-success px-5 fw-bold shadow">Salvar Dados</button>
        </div>
    </form>
</div>

@await Html.PartialAsync("_ModalImageCropper", new ModalCropperOptions {
ModalId = "modalEmpreendimento",
    Title = "Recortar Foto",
    EnableAvatars = false
})
