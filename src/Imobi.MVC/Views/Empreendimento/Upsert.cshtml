@using Imobi.MVC.Models.Components
@using Imobi.Domain.Enum
@model Imobi.MVC.ViewModels.EmpreendimentoViewModel

@{
    var isEdicao = Model.Id != Guid.Empty;
    ViewData["Title"] = isEdicao ? "Editar Empreendimento" : "Novo Empreendimento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .custom-switch-lg .form-check-input {
        width: 3rem;
        height: 1.5rem;
        cursor: pointer;
    }

    .item-galeria {
        transition: transform 0.2s;
    }

    #previewNovasImagens .card, #imagensExistentesContainer .card {
        min-width: 180px;
    }
</style>

@await Html.PartialAsync("_Loader")

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-dark fw-bold">@(isEdicao ? "Editar" : "Cadastrar") Empreendimento</h3>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Voltar para a Lista</a>
    </div>

    <form asp-action="Upsert" id="form-upsert" enctype="multipart/form-data" class="needs-validation" novalidate>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="EnderecoId" />

        <div class="card shadow-sm mb-4">
            <details open>
                <summary class="card-header bg-light fw-bold text-primary d-flex align-items-center" style="cursor:pointer">
                    <i class="bi bi-info-circle me-2"></i> Informações do Empreendimento
                </summary>
                <div class="card-body row g-3">
                    <div class="col-md-8">
                        <label asp-for="Nome" class="form-label fw-semibold"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Estagio" class="form-label fw-semibold"></label>
                        <input asp-for="Estagio" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="AreaConstruida" class="form-label fw-semibold"></label>
                        <input asp-for="AreaConstruida" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="DormitoriosTotal" class="form-label fw-semibold"></label>
                        <input asp-for="DormitoriosTotal" class="form-control" type="number" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="VagasTotal" class="form-label fw-semibold"></label>
                        <input asp-for="VagasTotal" class="form-control" type="number" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check form-switch mb-2 custom-switch-lg">
                            <input asp-for="Status" class="form-check-input" type="checkbox" />
                            <label class="form-check-label fw-bold text-dark" asp-for="Status">Ativo</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label asp-for="Sobre" class="form-label fw-semibold"></label>
                        <textarea asp-for="Sobre" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </details>
        </div>

        <div class="card shadow-sm mb-4">
            <details>
                <summary class="card-header bg-light fw-bold text-primary d-flex align-items-center" style="cursor:pointer">
                    <i class="bi bi-geo-alt me-2"></i> Localização
                </summary>
                <div class="card-body row g-3">
                    <div class="col-md-3">
                        <label asp-for="Endereco.Cep" class="form-label fw-semibold"></label>
                        <input asp-for="Endereco.Cep" class="form-control" id="Endereco_Cep" maxlength="9" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Endereco.Logradouro" class="form-label fw-semibold"></label>
                        <input asp-for="Endereco.Logradouro" class="form-control bg-light" id="Endereco_Logradouro" readonly />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Endereco.Numero" class="form-label fw-semibold"></label>
                        <input asp-for="Endereco.Numero" class="form-control" id="Endereco_Numero" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Endereco.Bairro" class="form-label fw-semibold"></label>
                        <input asp-for="Endereco.Bairro" class="form-control bg-light" id="Endereco_Bairro" readonly />
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Endereco.Cidade" class="form-label fw-semibold"></label>
                        <input asp-for="Endereco.Cidade" class="form-control bg-light" id="Endereco_Cidade" readonly />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Endereco.Uf" class="form-label fw-semibold"></label>
                        <input asp-for="Endereco.Uf" class="form-control bg-light" id="Endereco_Uf" readonly />
                    </div>
                </div>
            </details>
        </div>

        <div class="card shadow-sm mb-4 border-primary">
            <details open>
                <summary class="card-header bg-light fw-bold text-primary d-flex justify-content-between align-items-center" style="cursor:pointer">
                    <span><i class="bi bi-images me-2"></i> Galeria de Fotos</span>
                </summary>
                <div class="card-body">
                    <div class="mb-3">
                        <button type="button" class="btn btn-primary btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#modalEmpreendimento">
                            <i class="bi bi-camera-fill me-1"></i> Adicionar Foto
                        </button>
                    </div>

                    <div id="imagensExistentesContainer" class="row g-3">
                        @for (int i = 0; i < Model.Imagens.Count; i++)
                        {
                            <div class="col-md-3 item-galeria">
                                <div class="card h-100 shadow-sm border">
                                    <input type="hidden" name="Imagens[@i].Id" value="@Model.Imagens[i].Id" />
                                    <input type="hidden" name="Imagens[@i].Base64" value="@Model.Imagens[i].Base64" />
                                    <div class="position-relative">
                                        <img src="@Model.Imagens[i].Base64" class="card-img-top" style="height: 140px; object-fit: cover;">
                                        <span class="badge bg-dark position-absolute top-0 start-0 m-2"># @(i + 1)</span>
                                    </div>
                                    <div class="card-body p-2">
                                        <select name="Imagens[@i].Tipo" class="form-select form-select-sm mb-1" asp-items="Html.GetEnumSelectList<TipoImagemEmpreendimentoEnum>()"></select>
                                        <input type="text" name="Imagens[@i].Legenda" class="form-control form-control-sm mb-1" value="@Model.Imagens[i].Legenda" />
                                        <input type="hidden" name="Imagens[@i].Ordem" value="@Model.Imagens[i].Ordem" />
                                        <button type="button" class="btn btn-sm btn-outline-danger w-100 mt-1 btn-remover-logico">
                                            <i class="bi bi-trash-fill"></i> Remover
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div id="previewNovasImagens" class="d-flex flex-wrap gap-3 mt-4">
                    </div>
                </div>
            </details>
        </div>

        <div class="d-flex justify-content-end gap-2 pb-5 mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-success px-5 fw-bold shadow">Salvar Dados</button>
        </div>
    </form>
</div>

@await Html.PartialAsync("_ModalImageCropper", new ModalCropperOptions { ModalId = "modalEmpreendimento", Title = "Recortar Foto", EnableAvatars = false })

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script src="~/js/components/image-cropper.js"></script>

    <script>
        $(function () {
            const MAX_IMAGENS = 20;

            const container = document.getElementById('imagensExistentesContainer');
            if (container) {
                new Sortable(container, {
                    animation: 150,
                    ghostClass: 'sortable-ghost',
                    onEnd: function () {
                        reordenarIndices();
                    }
                });
            }

            initImageCropper('modalEmpreendimento', {
                aspectRatio: 16 / 9,
                onConfirm: function (base64) {
                    const totalImagens = $('#imagensExistentesContainer .item-galeria').length;

                    if (totalImagens >= MAX_IMAGENS) {
                        alert("Limite de 20 imagens atingido!");
                        return;
                    }

                    const card = `
                        <div class="col-md-3 item-galeria">
                            <div class="card h-100 shadow-sm border-primary">
                                <input type="hidden" name="Imagens[${totalImagens}].Id" value="00000000-0000-0000-0000-000000000000" />
                                <input type="hidden" name="Imagens[${totalImagens}].Base64" value="${base64}" />

                                <div class="position-relative">
                                    <img src="${base64}" class="card-img-top" style="height: 140px; object-fit: cover;">
                                    <span class="badge bg-primary position-absolute top-0 start-0 m-2 badge-ordem"># ${totalImagens + 1}</span>
                                </div>

                                <div class="card-body p-2">
                                    <select name="Imagens[${totalImagens}].Tipo" class="form-select form-select-sm mb-1">
                                        <option value="0">Fachada</option>
                                        <option value="1">Planta</option>
                                        <option value="2">Lazer</option>
                                        <option value="3">Decorado</option>
                                        <option value="4">Comum</option>
                                        <option value="5">Entorno</option>
                                    </select>
                                    <input type="text" name="Imagens[${totalImagens}].Legenda" class="form-control form-control-sm mb-1" placeholder="Legenda da foto" />
                                    <input type="hidden" name="Imagens[${totalImagens}].Ordem" value="${totalImagens + 1}" />

                                    <button type="button" class="btn btn-sm btn-outline-danger w-100 mt-1 btn-remover-logico">
                                        <i class="bi bi-trash-fill"></i> Remover
                                    </button>
                                </div>
                            </div>
                        </div>`;

                    $('#imagensExistentesContainer').append(card);
                    reordenarIndices();
                }
            });

            $(document).on('click', '.btn-remover-logico', function () {
                $(this).closest('.item-galeria').remove();
                reordenarIndices();
            });

            function reordenarIndices() {
                $('#imagensExistentesContainer .item-galeria').each(function (i, el) {
                    $(el).find('input, select').each(function () {
                        const name = $(this).attr('name');
                        if (name) {
                            const newName = name.replace(/Imagens\[\d+\]/, 'Imagens[' + i + ']');
                            $(this).attr('name', newName);
                        }
                    });

                    $(el).find('.badge-ordem, .badge').text('# ' + (i + 1));
                    $(el).find('input[name$=".Ordem"]').val(i + 1);
                });
            }
        });
    </script>
}