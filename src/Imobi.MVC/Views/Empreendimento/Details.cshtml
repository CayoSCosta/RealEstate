@using Imobi.Domain.Enum
@model Imobi.MVC.ViewModels.EmpreendimentoViewModel

@{
    ViewData["Title"] = "Detalhes do Empreendimento";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var linkMapsCep = $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(Model.Endereco.Cep)}";
}

@await Html.PartialAsync("_Loader")

<div class="container-fluid py-4 px-4">

    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <div>
            <h3 class="fw-bold text-dark mb-0">@Model.Nome</h3>
            <small class="text-muted">ID: @Model.Id</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary px-3">
                <i class="bi bi-arrow-left me-1"></i> Voltar
            </a>
            <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-primary px-4 shadow">
                <i class="bi bi-pencil-square me-1"></i> Editar
            </a>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-xl-9 col-lg-8">

            <div class="card shadow-sm mb-4 border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                        <h5 class="text-primary fw-bold mb-0">
                            <i class="bi bi-info-circle-fill me-2"></i> Informações Gerais
                        </h5>
                        <div class="d-flex gap-3">
                            <div class="d-flex align-items-center">
                                <span class="small fw-bold text-muted me-2">STATUS:</span>
                                @if (Model.Status)
                                {
                                    <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success px-3">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger px-3">Inativo</span>
                                }
                            </div>
                            <div class="d-flex align-items-center border-start ps-3">
                                <span class="small fw-bold text-muted me-2">OBRA:</span>
                                <span class="badge rounded-pill bg-info bg-opacity-10 text-info border border-info px-3">
                                    <i class="bi bi-cone-striped me-1"></i> @Model.Estagio
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <h6 class="fw-bold text-dark"><i class="bi bi-chat-left-text me-2 text-primary"></i> Sobre o Empreendimento</h6>
                        <p class="text-muted text-justify mb-0">
                            @Model.Sobre
                        </p>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4 border-0">
                <details open>
                    <summary class="card-header bg-light fw-bold text-primary d-flex align-items-center justify-content-between" style="cursor:pointer">
                        <span><i class="bi bi-houses me-2"></i> Unidades Vinculadas</span>
                        <div class="d-flex gap-2 align-items-center">
                            <a class="btn btn-sm btn-primary" asp-controller="Unidade" asp-action="Upsert" asp-route-empreendimentoId="@Model.Id">
                                <i class="bi bi-plus-lg"></i> Adicionar Unidade
                            </a>
                            <i class="bi bi-chevron-down text-muted small"></i>
                        </div>
                    </summary>
                    <div class="card-body p-0">
                        @if (Model.Unidades != null && Model.Unidades.Any())
                        {
                            <div class="scroll-container">
                                @await Html.PartialAsync("_tabelaUnidade", Model.Unidades)
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
                                Nenhuma unidade cadastrada.
                            </div>
                        }
                    </div>
                </details>
            </div>
        </div>

        <div class="col-xl-3 col-lg-4">

            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header bg-light fw-bold text-primary">Galeria de Fotos</div>
                <div class="card-body p-2">
                    @if (Model.Imagens != null && Model.Imagens.Any())
                    {
                        <div class="scroll-container px-1" style="max-height: 480px;">
                            <div class="row g-2">
                                @foreach (var img in Model.Imagens.Take(12))
                                {
                                    <div class="col-6">
                                        <img src="@img.Base64" class="img-fluid rounded shadow-sm"
                                             style="height: 100px; width: 100%; object-fit: cover;" />
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-camera fs-2 d-block mb-2"></i>
                            <small>Sem fotos</small>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light fw-bold text-primary">Localização</div>
                <div class="card-body">
                    <div class="d-flex mb-3">
                        <i class="bi bi-geo-alt-fill text-danger fs-4 me-3"></i>
                        <div class="small">
                            <p class="mb-0 fw-bold">@Model.Endereco.Logradouro, @Model.Endereco.Numero</p>
                            <p class="mb-0 text-muted">@Model.Endereco.Bairro</p>
                            <p class="mb-0 text-muted">@Model.Endereco.Cidade - @Model.Endereco.Uf</p>
                            <p class="mb-0 small text-primary fw-bold mt-1">CEP: @Model.Endereco.Cep</p>
                        </div>
                    </div>
                    <a href="@linkMapsCep" target="_blank" class="btn btn-sm btn-outline-secondary w-100">
                        <i class="bi bi-map me-1"></i> Ver no Google Maps
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>