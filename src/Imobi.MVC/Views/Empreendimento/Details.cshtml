@model Imobi.MVC.ViewModels.EmpreendimentoViewModel

@{
    ViewData["Title"] = "Detalhes do Empreendimento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <div>
            <h3 class="fw-bold text-dark mb-0">@Model.Nome</h3>
            <small class="text-muted">Cód: @Model.Id.ToString()</small>
        </div>
        <span class="badge @(Model.Status ? "bg-success" : "bg-secondary") px-3 py-2">
            @(Model.Status ? "Ativo" : "Inativo")
        </span>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-body">
                    <h5 class="text-primary fw-bold border-bottom pb-2 mb-3">Descrição</h5>
                    <p class="text-muted" style="text-align: justify; line-height: 1.6;">
                        @Model.Sobre
                    </p>

                    <div class="row mt-4 text-center bg-light rounded py-3 g-2">
                        <div class="col-3 border-end">
                            <i class="bi bi-rulers d-block fs-4 text-primary"></i>
                            <small class="text-muted d-block mt-1">Área Mín.</small>
                            <p class="fw-bold mb-0">@(Model.AreaConstruida?.ToString() ?? "0") m²</p>
                        </div>
                        <div class="col-3 border-end">
                            <i class="bi bi-door-open d-block fs-4 text-primary"></i>
                            <small class="text-muted d-block mt-1">Quartos</small>
                            <p class="fw-bold mb-0">@(Model.DormitoriosTotal?.ToString() ?? "0")</p>
                        </div>
                        <div class="col-3 border-end">
                            <i class="bi bi-car-front d-block fs-4 text-primary"></i>
                            <small class="text-muted d-block mt-1">Vagas</small>
                            <p class="fw-bold mb-0">@(Model.VagasTotal?.ToString() ?? "0")</p>
                        </div>
                        <div class="col-3">
                            <i class="bi bi-building-up d-block fs-4 text-primary"></i>
                            <small class="text-muted d-block mt-1">Estágio</small>
                            <p class="fw-bold mb-0">@Model.Estagio</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary fw-bold">Unidades Vinculadas</h5>
                    <a class="btn btn-sm btn-primary" asp-controller="Unidade" asp-action="Upsert" asp-route-empreendimentoId="@Model.Id">
                        <i class="bi bi-plus-lg"></i> Adicionar Unidade
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (Model.Unidades != null && Model.Unidades.Any())
                    {
                        @await Html.PartialAsync("_tabelaUnidade", Model.Unidades)
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
                            Nenhuma unidade cadastrada para este empreendimento.
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header bg-light fw-bold text-primary">Galeria de Fotos</div>
                <div class="card-body p-2">
                    @if (Model.Imagens != null && Model.Imagens.Any())
                    {
                        <div class="row g-2">
                            @foreach (var img in Model.Imagens)
                            {
                                <div class="col-6">
                                    <img src="@img.Base64"
                                         class="img-fluid rounded shadow-sm gallery-img"
                                         style="height: 120px; width: 100%; object-fit: cover; cursor: pointer;"
                                         alt="Imagem do empreendimento" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-camera fs-2 d-block mb-2"></i>
                            Sem fotos disponíveis.
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light fw-bold text-primary">Localização</div>
                <div class="card-body">
                    <div class="d-flex mb-3">
                        <i class="bi bi-geo-alt-fill text-danger fs-4 me-3"></i>
                        <div>
                            <p class="mb-0 fw-bold">@Model.Endereco.Logradouro, @Model.Endereco.Numero</p>
                            <p class="mb-0 text-muted">@Model.Endereco.Bairro</p>
                            <p class="mb-0 text-muted">@Model.Endereco.Cidade - @Model.Endereco.Uf</p>
                            <p class="mb-0 small text-primary fw-bold">CEP: @Model.Endereco.Cep</p>
                        </div>
                    </div>
                    <a href="https://www.google.com/maps/search/?api=1&query=@(Uri.EscapeDataString($"{Model.Endereco.Logradouro}, {Model.Endereco.Numero}, {Model.Endereco.Cidade}"))"
                       target="_blank" class="btn btn-sm btn-outline-secondary w-100">
                        <i class="bi bi-map me-1"></i> Ver no Google Maps
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
        <a asp-action="Index" class="btn btn-outline-secondary px-4">
            <i class="bi bi-arrow-left me-1"></i> Voltar
        </a>
        <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-primary px-5 shadow">
            <i class="bi bi-pencil-square me-1"></i> Editar Empreendimento
        </a>
    </div>
</div>