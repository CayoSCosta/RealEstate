@using Imobi.MVC.ViewModels
@model IEnumerable<UnidadeViewModel>

<div style="padding: 15px;">
    <table class="table shadow-sm">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Status)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Tipo)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Dormitorios)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Suites)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Banheiros)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Vagas)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.AreaConstruida)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Valor)
                </th>
                <th>
                    Empreendimento
                </th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.Status)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inativo</span>
                            }
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Tipo)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Dormitorios)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Suites)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Banheiros)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Vagas)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AreaConstruida) m²
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Valor)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Empreendimento.Nome)
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-controller="Unidade" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-controller="Unidade" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Detalhes">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-controller="Unidade" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center text-muted">Nenhuma unidade cadastrada.</td>
                </tr>
            }
        </tbody>
    </table>
</div>