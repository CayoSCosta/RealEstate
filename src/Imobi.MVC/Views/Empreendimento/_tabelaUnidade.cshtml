@using Imobi.MVC.ViewModels
@model IEnumerable<UnidadeViewModel>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="bg-light">
            <tr>
                <th class="border-top-0">Status</th>
                <th class="border-top-0">@Html.DisplayNameFor(model => model.Tipo)</th>
                <th class="border-top-0 text-center">@Html.DisplayNameFor(model => model.Dormitorios)</th>
                <th class="border-top-0 text-center">@Html.DisplayNameFor(model => model.Suites)</th>
                <th class="border-top-0 text-center">@Html.DisplayNameFor(model => model.Vagas)</th>
                <th class="border-top-0">@Html.DisplayNameFor(model => model.AreaConstruida)</th>
                <th class="border-top-0">@Html.DisplayNameFor(model => model.Valor)</th>
                <th class="border-top-0 text-end px-4">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.Status)
                            {
                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success px-2">Disponível</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger px-2">Vendido</span>
                            }
                        </td>
                        <td class="fw-bold text-dark">
                            @Html.DisplayFor(modelItem => item.Tipo)
                        </td>
                        <td class="text-center">@item.Dormitorios <i class="bi bi-bed text-muted small"></i></td>
                        <td class="text-center">@item.Suites <i class="bi bi-droplet text-muted small"></i></td>
                        <td class="text-center">@item.Vagas <i class="bi bi-car-front text-muted small"></i></td>
                        <td>
                            <span class="text-nowrap">@item.AreaConstruida m²</span>
                        </td>
                        <td class="fw-bold text-primary">
                            @(item.Valor.HasValue? item.Valor.Value.ToString("C") : "Sob consulta")
                        </td>
                        <td class="text-end px-4">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-controller="Unidade" asp-action="Upsert" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary border-0" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <a asp-controller="Unidade" asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-info border-0" title="Detalhes">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a asp-controller="Unidade" asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger border-0" title="Excluir">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center py-5 text-muted">
                        <i class="bi bi-info-circle d-block fs-2 mb-2"></i>
                        Nenhuma unidade cadastrada.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>