@model Imobi.MVC.ViewModels.EmpreendimentoViewModel

@{
    ViewData["Title"] = "Excluir Empreendimento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_Loader")

<style>
    summary::marker {
        color: #dc3545;
    }
</style>

<div class="py-4">
    <h3 class="mb-4 text-danger">
        <i class="bi bi-trash"></i> Excluir Empreendimento
    </h3>

    <div class="alert alert-warning shadow-sm">
        <strong>Atenção!</strong> Esta ação é irreversível.
        Tem certeza de que deseja excluir este empreendimento?
    </div>

    <div class="card shadow-sm mb-4 border-danger">
        <details open>
            <summary class="card-header bg-light d-flex justify-content-between align-items-center">
                <span class="summary-title flex-grow-1" style="color: #dc3545;">Sobre o Empreendimento</span>
            </summary>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <strong>Nome:</strong>
                    <p class="form-control-plaintext">@Model.Nome</p>
                </div>
                <div class="col-md-6">
                    <strong>Status:</strong>
                    <div class="form-check mt-1">
                        <input class="form-check-input" type="checkbox" disabled @(Model.Status ? "checked" : "") />
                        <label class="form-check-label">Ativo</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <strong>Estágio:</strong>
                    <p class="form-control-plaintext">@Model.Estagio</p>
                </div>
            </div>
        </details>
    </div>

    <div class="card shadow-sm mb-4 border-danger">
        <details open>
            <summary class="card-header bg-light d-flex justify-content-between align-items-center">
                <span class="summary-title flex-grow-1" style="color: #dc3545;">Endereço</span>
            </summary>
            <div class="card-body row g-3">
                <div class="col-md-3">
                    <strong>CEP:</strong>
                    <p class="form-control-plaintext">@Model.Endereco?.Cep</p>
                </div>
                <div class="col-md-5">
                    <strong>Logradouro:</strong>
                    <p class="form-control-plaintext">@Model.Endereco?.Logradouro</p>
                </div>
                <div class="col-md-2">
                    <strong>Número:</strong>
                    <p class="form-control-plaintext">@Model.Endereco?.Numero</p>
                </div>
                <div class="col-md-2">
                    <strong>Bairro:</strong>
                    <p class="form-control-plaintext">@Model.Endereco?.Bairro</p>
                </div>
                <div class="col-md-6">
                    <strong>Cidade:</strong>
                    <p class="form-control-plaintext">@Model.Endereco?.Cidade</p>
                </div>
                <div class="col-md-2">
                    <strong>UF:</strong>
                    <p class="form-control-plaintext">@Model.Endereco?.Uf</p>
                </div>
            </div>
        </details>
    </div>

    @if (Model.Imagens != null && Model.Imagens.Any())
    {
        <div class="card shadow-sm mb-4 border-danger">
            <details open>
                <summary class="card-header bg-light d-flex justify-content-between align-items-center">
                    <span class="summary-title flex-grow-1" style="color: #dc3545;">Imagens</span>
                </summary>
                <div class="card-body">
                    <div class="horizontal-carousel d-flex overflow-auto py-2">
                        @foreach (var imagem in Model.Imagens)
                        {
                            <div class="card shadow-sm me-3" style="min-width: 180px;">
                                <div class="card-img-wrapper" style="height: 120px; overflow: hidden;">
                                    <img src="@imagem.Base64" class="card-img-top" alt="Imagem" style="object-fit: cover; height: 100%; width: 100%;" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </details>
        </div>
    }

    @if (Model.Unidades != null && Model.Unidades.Any())
    {
        <div class="card shadow-sm mb-4 border-danger">
            <details open>
                <summary class="card-header bg-light d-flex justify-content-between align-items-center">
                    <span class="summary-title flex-grow-1" style="color: #dc3545;">Unidades Vinculadas (Serão Excluídas)</span>
                </summary>
                <div class="card-body p-0">
                    @await Html.PartialAsync("_tabelaUnidade", Model.Unidades)
                </div>
            </details>
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4 border-danger">
            <details open>
                <summary class="card-header bg-light d-flex justify-content-between align-items-center">
                    <span class="summary-title flex-grow-1" style="color: #dc3545;">Unidades Vinculadas</span>
                </summary>
                <div class="card-body text-center text-muted py-4">
                    <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
                    Nenhuma unidade vinculada a este empreendimento.
                </div>
            </details>
        </div>
    }

    <form asp-action="Delete" id="form-delete" class="mt-4">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-x-circle"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-danger px-4">
                <i class="bi bi-trash"></i> Excluir
            </button>
        </div>
    </form>
</div>

<script>
    const form = document.getElementById("form-delete");

    if (form) {
        form.addEventListener("submit", function (e) {
            Loading.show("Deletando dados...");
            e.preventDefault();
            setTimeout(() => form.submit(), 1);
        });
    }
</script>