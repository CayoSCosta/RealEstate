@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var user = HttpContextAccessor.HttpContext?.User;
    var isAuthenticated = user?.Identity?.IsAuthenticated ?? false;
}

<!DOCTYPE html>
<html lang="pt-br" class="h-100">
<head> 
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Imobi</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script src="~/js/components/image-cropper.js"></script>

    <link rel="stylesheet" href="~/css/theme.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/sidebar.css" />
    <link rel="stylesheet" href="~/css/loading.css" />
    <link rel="stylesheet" href="~/css/toast.css" />
    <link rel="stylesheet" href="~/css/cropper-custom.css" />
    <link rel="stylesheet" href="~/css/forms.css" />
    <link rel="stylesheet" href="~/css/navegation.css" />



    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="h-100 @(isAuthenticated ? "auth-user" : "no-auth")">

    @if (isAuthenticated)
    {
        <div class="d-flex w-100 h-100 overflow-hidden">

            <partial name="_Sidebar" />

            <div id="content" class="d-flex flex-column flex-grow-1 min-vh-100 transition-all">

                <partial name="_Navbar" />

                <main class="flex-grow-1 overflow-auto p-4">
                    <div class="container-fluid">
                        @await Html.PartialAsync("_Alerta")

                        <div class="fade-in">
                            @RenderBody()
                        </div>
                    </div>
                </main>

                <footer class="footer mt-auto py-3 bg-white border-top text-center text-muted">
                    <div class="container">
                        <small>&copy; 2025 - Imobi RealEstate - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidade</a></small>
                    </div>
                </footer>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column min-vh-100">
            <main class="flex-grow-1 d-flex align-items-center justify-content-center bg-light">
                <div class="w-100">
                    @await Html.PartialAsync("_Alerta")
                    @RenderBody()
                </div>
            </main>
            <footer class="py-3 text-center text-muted border-top bg-white">
                &copy; 2025 - Imobi
            </footer>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>