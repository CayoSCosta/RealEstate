@{
    ViewData["Title"] = "Email Enviado";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h4>Verifique seu email</h4>
                    <p class="mt-3">
                        Se existir uma conta associada a este endereço, você receberá um link de recuperação de senha.
                    </p>

                    <a asp-action="Login" class="btn btn-primary mt-3">Voltar ao Login</a>
                </div>
            </div>
        </div>
    </div>
</div>
