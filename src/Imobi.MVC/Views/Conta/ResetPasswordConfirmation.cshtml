@{
    ViewData["Title"] = "Senha Redefinida";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h4>Senha redefinida com sucesso!</h4>
                    <p class="mt-3">
                        Agora você já pode fazer login com sua nova senha.
                    </p>

                    <a asp-action="Login" class="btn btn-primary mt-3">Ir para Login</a>
                </div>
            </div>
        </div>
    </div>
</div>
