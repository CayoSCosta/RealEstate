@model List<UsuarioListItemViewModel>

<div class="container">
	<h3 class="mb-4">Gerenciar Usuários</h3>

	<p>
		<a asp-action="Create" class="btn btn-success">Novo</a>
	</p>
	<table class="table table-hover shadow-sm">
		<thead class="table-light">
			<tr>
				<th>Email</th>
				<th>Ativo</th>
				<th>Funções</th>
				<th>Ações</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var user in Model)
			{
				<tr>
					<td>@user.Email</td>
					<td>
						@if (user.Ativo)
						{
							<span class="badge bg-success">Ativo</span>
						}
						else
						{
							<span class="badge bg-danger">Inativo</span>
						}
					</td>

					<td>
						@foreach (var role in user.RolesNames)
						{
							<span class="badge bg-primary">@role</span>
						}
					</td>

					<td class="text-end">
                        <div class="d-flex gap-1">
							<a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                <i class="bi bi-pencil-square"></i>
							</a>
							<a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-info" title="Detalhes">
								<i class="bi bi-eye"></i>
							</a>
                            <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger" title="Excluir">
								<i class="bi bi-trash"></i>
							</a>
						</div>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>