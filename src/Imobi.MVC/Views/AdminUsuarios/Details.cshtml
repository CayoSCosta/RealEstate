@model UsuarioListItemViewModel

@{
    ViewData["Title"] = "Detalhes do Usuário";
}

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-0">
            Detalhes do Usuário
        </h5>
    </div>

    <div class="card-body">
        <dl class="row g-3 mb-0">

            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">
                @Model.Nome @Model.SobreNome
            </dd>

            <dt class="col-sm-3">E-mail</dt>
            <dd class="col-sm-9">
                @Model.Email
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.Ativo)
                {
                    <span class="badge bg-success">Ativo</span>
                }
                else
                {
                    <span class="badge bg-danger">Inativo</span>
                }
            </dd>

            <dt class="col-sm-3">Perfis</dt>
            <dd class="col-sm-9">
                @if (Model.RolesNames != null && Model.RolesNames.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var role in Model.RolesNames)
                        {
                            <span class="badge rounded-pill bg-primary">
                                <i class="bi bi-person-badge me-1"></i>
                                @role
                            </span>
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted">
                        Nenhum perfil atribuído
                    </span>
                }
            </dd>

        </dl>
    </div>
</div>
    <div class="text-end mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>

    </div>

