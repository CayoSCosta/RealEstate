@model EditRolesViewModel
@{
    ViewData["Title"] = "Editar Permissões";
}

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-0">
            Editar Roles — @Model.Email
        </h5>
    </div>

    <form asp-action="EditRoles" method="post">
        <div class="card-body">
            <input type="hidden" asp-for="UserId" />

            <div class="row g-3">
                @foreach (var role in Model.Roles)
                {
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input"
                                   asp-for="@role.Selected"
                                   name="Roles[@Model.Roles.IndexOf(role)].Selected" />

                            <label class="form-check-label">
                                @role.Name
                            </label>

                            <input type="hidden"
                                   name="Roles[@Model.Roles.IndexOf(role)].Name"
                                   value="@role.Name" />
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card-footer text-end">
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            <button class="btn btn-primary">
                <i class="bi bi-check-circle me-1"></i> Salvar
            </button>
        </div>
    </form>
</div>
