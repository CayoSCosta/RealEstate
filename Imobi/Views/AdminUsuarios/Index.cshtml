@model IEnumerable<Imobi.Models.Identity.ApplicationUser>
@{
    ViewData["Title"] = "Usuários";
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Gerenciamento de Usuários</h5>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Novo Usuário
        </a>
    </div>

    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Roles</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.Nome @u.SobreNome</td>
                        <td>@u.Email</td>
                        <td>
                            @if (u.Ativo)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inativo</span>
                            }
                        </td>
                        <td>
                            <small class="text-muted">
                                (ver em "Editar Roles")
                            </small>
                        </td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a asp-action="EditRoles" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-shield-lock"></i>
                                </a>

                                <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-sm btn-outline-warning"
                                   onclick="return confirm('Redefinir senha deste usuário?');">
                                    <i class="bi bi-key"></i>
                                </a>

                                <a asp-action="ToggleStatus" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-power"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
