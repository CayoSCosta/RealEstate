@model Imobi.Models.Empreendimento

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit</h1>

<h4>Empreendimento</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Status" /> @Html.DisplayNameFor(model => model.Status)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Sobre" class="control-label"></label>
                <input asp-for="Sobre" class="form-control" />
                <span asp-validation-for="Sobre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AreaConstruida" class="control-label"></label>
                <input asp-for="AreaConstruida" class="form-control" />
                <span asp-validation-for="AreaConstruida" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Estagio" class="control-label"></label>
                <input asp-for="Estagio" class="form-control" />
                <span asp-validation-for="Estagio" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BanheirosTotal" class="control-label"></label>
                <input asp-for="BanheirosTotal" class="form-control" />
                <span asp-validation-for="BanheirosTotal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DormitoriosTotal" class="control-label"></label>
                <input asp-for="DormitoriosTotal" class="form-control" />
                <span asp-validation-for="DormitoriosTotal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SuitesTotal" class="control-label"></label>
                <input asp-for="SuitesTotal" class="form-control" />
                <span asp-validation-for="SuitesTotal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="VagasTotal" class="control-label"></label>
                <input asp-for="VagasTotal" class="form-control" />
                <span asp-validation-for="VagasTotal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UnidadeId" class="control-label"></label>
                <input asp-for="UnidadeId" class="form-control" />
                <span asp-validation-for="UnidadeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EnderecoId" class="control-label"></label>
                <select asp-for="EnderecoId" class="form-control" asp-items="ViewBag.EnderecoId"></select>
                <span asp-validation-for="EnderecoId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
