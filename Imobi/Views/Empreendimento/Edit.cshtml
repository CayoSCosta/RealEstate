@model Imobi.Models.Empreendimento

@{
	ViewData["Title"] = "Editar Empreendimento";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
	<h3 class="mb-4">Editar Empreendimento</h3>

	<form asp-action="Edit" enctype="multipart/form-data" class="needs-validation" novalidate>
		<input type="hidden" asp-for="Id" />
		<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

		<!-- SEÇÃO: DADOS GERAIS -->
		<div class="card shadow-sm mb-4">
			<div class="card-header bg-light">
				<h5 class="mb-0">Sobre o Empreendimento</h5>
			</div>
			<div class="card-body row g-3">
				<div class="col-md-6">
					<label asp-for="Nome" class="form-label fw-semibold"></label>
					<input asp-for="Nome" class="form-control" />
					<span asp-validation-for="Nome" class="text-danger"></span>
				</div>

				<div class="col-md-6">
					<label asp-for="Sobre" class="form-label fw-semibold"></label>
					<input asp-for="Sobre" class="form-control" />
					<span asp-validation-for="Sobre" class="text-danger"></span>
				</div>

				<div class="col-md-3">
					<label asp-for="Estagio" class="form-label fw-semibold"></label>
					<input asp-for="Estagio" class="form-control" />
					<span asp-validation-for="Estagio" class="text-danger"></span>
				</div>

				<div class="col-md-3">
					<label asp-for="AreaConstruida" class="form-label fw-semibold"></label>
					<input asp-for="AreaConstruida" class="form-control" />
					<span asp-validation-for="AreaConstruida" class="text-danger"></span>
				</div>

				<div class="col-md-3">
					<label asp-for="DormitoriosTotal" class="form-label fw-semibold"></label>
					<input asp-for="DormitoriosTotal" class="form-control" />
					<span asp-validation-for="DormitoriosTotal" class="text-danger"></span>
				</div>

				<div class="col-md-3">
					<label asp-for="SuitesTotal" class="form-label fw-semibold"></label>
					<input asp-for="SuitesTotal" class="form-control" />
					<span asp-validation-for="SuitesTotal" class="text-danger"></span>
				</div>

				<div class="col-md-3">
					<label asp-for="BanheirosTotal" class="form-label fw-semibold"></label>
					<input asp-for="BanheirosTotal" class="form-control" />
					<span asp-validation-for="BanheirosTotal" class="text-danger"></span>
				</div>

				<div class="col-md-3">
					<label asp-for="VagasTotal" class="form-label fw-semibold"></label>
					<input asp-for="VagasTotal" class="form-control" />
					<span asp-validation-for="VagasTotal" class="text-danger"></span>
				</div>

@* 				<div class="col-md-6">
					<label class="form-label fw-semibold">Upload de novas imagens</label>
					<input asp-for="Imagens" type="file" class="form-control" multiple />
					<span asp-validation-for="Imagens" class="text-danger"></span>
				</div> *@

				<div class="col-md-1">
					<div class="form-check">
						<div class="form-check form-switch">
							<input asp-for="Status" class="form-check-input" type="checkbox" />
							<label class="form-check-label" asp-for="Status">Ativo</label>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- SEÇÃO: ENDEREÇO -->
		<div class="card shadow-sm mb-4">
			<div class="card-header bg-light">
				<h5 class="mb-0">Endereço</h5>
			</div>
			<div class="card-body row g-3">
				<div class="col-md-3">
					<label asp-for="Endereco.Cep" class="form-label fw-semibold"></label>
					<input asp-for="Endereco.Cep" class="form-control" placeholder="00000-000" />
					<span asp-validation-for="Endereco.Cep" class="text-danger"></span>
				</div>

				<div class="col-md-5">
					<label asp-for="Endereco.Logradouro" class="form-label fw-semibold"></label>
					<input asp-for="Endereco.Logradouro" class="form-control" />
					<span asp-validation-for="Endereco.Logradouro" class="text-danger"></span>
				</div>

				<div class="col-md-2">
					<label asp-for="Endereco.Numero" class="form-label fw-semibold"></label>
					<input asp-for="Endereco.Numero" class="form-control" />
					<span asp-validation-for="Endereco.Numero" class="text-danger"></span>
				</div>

				<div class="col-md-2">
					<label asp-for="Endereco.Bairro" class="form-label fw-semibold"></label>
					<input asp-for="Endereco.Bairro" class="form-control" />
					<span asp-validation-for="Endereco.Bairro" class="text-danger"></span>
				</div>

				<div class="col-md-4">
					<label asp-for="Endereco.Complemento" class="form-label fw-semibold"></label>
					<input asp-for="Endereco.Complemento" class="form-control" />
					<span asp-validation-for="Endereco.Complemento" class="text-danger"></span>
				</div>

				<div class="col-md-6">
					<label asp-for="Endereco.Cidade" class="form-label fw-semibold"></label>
					<input asp-for="Endereco.Cidade" class="form-control" />
					<span asp-validation-for="Endereco.Cidade" class="text-danger"></span>
				</div>

				<div class="col-md-2">
					<label asp-for="Endereco.Uf" class="form-label fw-semibold"></label>
					<input asp-for="Endereco.Uf" class="form-control text-uppercase" maxlength="2" />
					<span asp-validation-for="Endereco.Uf" class="text-danger"></span>
				</div>
			</div>
		</div>

		<!-- SEÇÃO: UNIDADES -->
		<div class="card shadow-sm mb-4">
			<div class="card-header bg-light d-flex justify-content-between align-items-center">
				<h5 class="mb-0">Unidades</h5>
				<a class="btn btn-outline-secondary" asp-area="" asp-controller="Unidade" asp-action="Create">+ Unidade</a>
			</div>
			<div class="card-body row g-3">
				@if (Model.Unidades.Any() && Model.Unidades != null)
				{
					@await Html.PartialAsync("_tabelaUnidade", Model.Unidades)
				}
				else
				{
					<div class="col-md-6">
						<p>Não há unidades cadastradas</p>
					</div>
				}
			</div>
		</div>

		<!-- SEÇÃO: IMAGENS -->
		<div class="card shadow-sm mb-4">
			<div class="card-header bg-light d-flex justify-content-between align-items-center">
				<h5 class="mb-0">IMAGENS</h5>
				<label for="imagensUpload" class="btn btn-outline-secondary mb-0">
					<i class="bi bi-plus"></i> + Imagens
				</label>
			</div>

			<div class="card-body">
				<input type="file" id="imagensUpload" name="Imagens" class="d-none" multiple accept="image/*" />

				<!-- ===================== IMAGENS JÁ CADASTRADAS ===================== -->
				<div class="mb-4 position-relative">
					<div class="position-absolute top-50 start-50 translate-middle text-secondary opacity-25 fw-bold user-select-none"
						 style="font-size: 2rem; pointer-events: none;">
						Imagens já cadastradas
					</div>

					@if (Model.Arquivos != null && Model.Arquivos.Any())
					{
						<div class="horizontal-carousel d-flex overflow-auto py-2" id="imagensExistentesContainer">
							@foreach (var arquivo in Model.Arquivos)
							{
								<div class="card shadow-sm me-3" style="min-width: 200px;">
									<div class="card-img-wrapper">
										<img src="@Url.Content("~/" + arquivo.Caminho)"
											 class="card-img-top rounded"
											 alt="@arquivo.Tipo"
											 style="object-fit: cover; height: 150px;" />
									</div>
									<div class="card-body text-center">
										<button type="button" class="btn btn-sm btn-danger mt-2" data-id="@arquivo.Id">
											<i class="bi bi-trash"></i> Remover
										</button>
									</div>
								</div>
							}
						</div>
					}
					else
					{
						<p>Não há imagens cadastradas</p>
					}
				</div>

				<hr />

				<!-- ===================== NOVAS IMAGENS ===================== -->
				<div class="position-relative mt-4">
					<div class="position-absolute top-50 start-50 translate-middle text-secondary opacity-25 fw-bold user-select-none"
						 style="font-size: 2rem; pointer-events: none;">
						Novas imagens
					</div>

					<div id="novasImagensContainer" class="d-flex overflow-auto py-2">
						<!-- As novas imagens aparecerão aqui -->
					</div>
				</div>
			</div>
		</div>

		<!-- BOTÕES -->
		<div class="d-flex justify-content-end gap-2">
			<a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
			<button type="submit" class="btn btn-primary">Salvar Alterações</button>
		</div>
	</form>
</div>

@section Scripts {
	@await Html.PartialAsync("_ValidationScriptsPartial")

	<script>
		// Busca de endereço via CEP (ViaCEP)
		document.getElementById("Endereco_Cep")?.addEventListener("blur", async function () {
			const cep = this.value.replace(/\D/g, '');
			if (cep.length !== 8) return;

			try {
				const res = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
				const data = await res.json();
				if (!data.erro) {
					document.getElementById("Endereco_Logradouro").value = data.logradouro || '';
					document.getElementById("Endereco_Bairro").value = data.bairro || '';
					document.getElementById("Endereco_Cidade").value = data.localidade || '';
					document.getElementById("Endereco_Uf").value = data.uf || '';
				}
			} catch (error) {
				console.error("Erro ao buscar CEP:", error);
			}
		});
	</script>

	<script>
		document.querySelectorAll('.btn-danger[data-id]').forEach(btn => {
			btn.addEventListener('click', async function() {
				const id = this.dataset.id;
				if (!confirm('Deseja realmente remover esta imagem?')) return;

				try {
					const res = await fetch(`/Imagem/Remover/${id}`, { method: 'POST' });
					if (res.ok) {
						this.closest('.card').remove();
					} else {
						alert('Erro ao remover a imagem.');
					}
				} catch (err) {
					console.error(err);
					alert('Erro ao remover a imagem.');
				}
			});
		});
	</script>
	<script>
		const inputImagens = document.getElementById('imagensUpload');
		const novasImagensContainer = document.getElementById('novasImagensContainer');

		// Ao selecionar novas imagens
		inputImagens.addEventListener('change', (event) => {
			const files = Array.from(event.target.files);
			novasImagensContainer.innerHTML = ''; // limpa o preview anterior

			if (files.length === 0) {
				novasImagensContainer.innerHTML = '<p class="text-muted">Nenhuma imagem selecionada</p>';
				return;
			}

			files.forEach((file, index) => {
				const reader = new FileReader();

				reader.onload = (e) => {
					const card = document.createElement('div');
					card.classList.add('card', 'shadow-sm', 'me-3');
					card.style.minWidth = '200px';

					card.innerHTML = `
						<div class="card-img-wrapper">
							<img src="${e.target.result}" class="card-img-top rounded" alt="Nova imagem" style="object-fit: cover; height: 150px;" />
						</div>
						<div class="card-body text-center">
							<button type="button" class="btn btn-sm btn-danger mt-2 remove-btn" data-index="${index}">
								<i class="bi bi-trash"></i> Remover
							</button>
						</div>
					`;

					novasImagensContainer.appendChild(card);
				};

				reader.readAsDataURL(file);
			});
		});

		// Remoção de imagem antes de enviar
		novasImagensContainer.addEventListener('click', (e) => {
			if (e.target.closest('.remove-btn')) {
				const index = parseInt(e.target.closest('.remove-btn').dataset.index);
				const dt = new DataTransfer();

				const currentFiles = Array.from(inputImagens.files);
				currentFiles.splice(index, 1); // remove a imagem clicada
				currentFiles.forEach(f => dt.items.add(f));

				inputImagens.files = dt.files; // atualiza o input real
				inputImagens.dispatchEvent(new Event('change')); // recarrega preview
			}
		});
	</script>

}
