@model Imobi.Models.Empreendimento

@{
    ViewData["Title"] = "Detalhes do Empreendimento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <h3 class="mb-4">Detalhes do Empreendimento</h3>

    <!-- CARD: Sobre o Empreendimento -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Sobre o Empreendimento</h5>
        </div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <strong>Status:</strong>
                <p>@Html.DisplayFor(model => model.Status)</p>
            </div>

            <div class="col-md-6">
                <strong>Nome:</strong>
                <p>@Html.DisplayFor(model => model.Nome)</p>
            </div>

            <div class="col-md-6">
                <strong>Sobre:</strong>
                <p>@Html.DisplayFor(model => model.Sobre)</p>
            </div>

            <div class="col-md-4">
                <strong>Estágio:</strong>
                <p>@Html.DisplayFor(model => model.Estagio)</p>
            </div>

            <div class="col-md-4">
                <strong>Área Construída:</strong>
                <p>@Html.DisplayFor(model => model.AreaConstruida) m²</p>
            </div>

            <div class="col-md-4">
                <strong>Vagas:</strong>
                <p>@Html.DisplayFor(model => model.VagasTotal)</p>
            </div>

            <div class="col-md-4">
                <strong>Banheiros:</strong>
                <p>@Html.DisplayFor(model => model.BanheirosTotal)</p>
            </div>

            <div class="col-md-4">
                <strong>Dormitórios:</strong>
                <p>@Html.DisplayFor(model => model.DormitoriosTotal)</p>
            </div>

            <div class="col-md-4">
                <strong>Suítes:</strong>
                <p>@Html.DisplayFor(model => model.SuitesTotal)</p>
            </div>
        </div>
    </div>

    <!-- CARD: Unidades (apenas se houver) -->
    @if (Model.Unidades != null && Model.Unidades.Any())
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Unidades do Empreendimento</h5>
                <a asp-controller="Unidade" asp-action="Create" asp-route-empreendimentoId="@Model.Id" class="btn btn-sm btn-primary">
                    + Nova Unidade
                </a>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tipo</th>
                            <th>Dormitórios</th>
                            <th>Suítes</th>
                            <th>Banheiros</th>
                            <th>Vagas</th>
                            <th>Área (m²)</th>
                            <th>Valor (R$)</th>
                            <th>Status</th>
                            <th style="width: 150px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var unidade in Model.Unidades)
                        {
                            <tr>
                                <td>@unidade.Tipo</td>
                                <td>@unidade.Dormitorios</td>
                                <td>@unidade.Suites</td>
                                <td>@unidade.Banheiros</td>
                                <td>@unidade.Vagas</td>
                                <td>@unidade.AreaConstruida</td>
                                <td>@(unidade.Valor.HasValue ? $"R$ {unidade.Valor.Value:N2}" : "-")</td>
                                <td>
                                    @if (unidade.Status)
                                    {
                                        <span class="badge bg-success">Ativa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inativa</span>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Unidade" asp-action="Edit" asp-route-id="@unidade.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <a asp-controller="Unidade" asp-action="Delete" asp-route-id="@unidade.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- CARD: Endereço -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Endereço</h5>
        </div>
        <div class="card-body row g-3">
            <div class="col-md-3">
                <strong>CEP:</strong>
                <p>@Html.DisplayFor(model => model.Endereco.Cep)</p>
            </div>
            <div class="col-md-5">
                <strong>Logradouro:</strong>
                <p>@Html.DisplayFor(model => model.Endereco.Logradouro)</p>
            </div>
            <div class="col-md-2">
                <strong>Número:</strong>
                <p>@Html.DisplayFor(model => model.Endereco.Numero)</p>
            </div>
            <div class="col-md-2">
                <strong>Bairro:</strong>
                <p>@Html.DisplayFor(model => model.Endereco.Bairro)</p>
            </div>
            <div class="col-md-4">
                <strong>Complemento:</strong>
                <p>@Html.DisplayFor(model => model.Endereco.Complemento)</p>
            </div>
            <div class="col-md-6">
                <strong>Cidade:</strong>
                <p>@Html.DisplayFor(model => model.Endereco.Cidade)</p>
            </div>
            <div class="col-md-2">
                <strong>UF:</strong>
                <p>@Html.DisplayFor(model => model.Endereco.Uf)</p>
            </div>
        </div>
    </div>

    <!-- BOTÕES -->
    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    </div>
</div>
