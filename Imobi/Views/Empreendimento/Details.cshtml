@model Imobi.Models.Empreendimento

@{
    ViewData["Title"] = "Detalhes do Empreendimento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <h3 class="mb-4">Detalhes do Empreendimento</h3>

    <!-- CARD: Sobre o Empreendimento -->
    <div class="card shadow-sm mb-4">
        <details open>
            <summary class="card-header bg-light">
                <span class="summary-title">Sobre o Empreendimento</span>
            </summary>
            <div class="card-body row g-3">
                <div class="form-check">
                    <div class="form-check form-switch">
                        <input asp-for="Status" class="form-check-input" disabled type="checkbox" />
                        <label class="form-check-label" asp-for="Status">Ativo</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>Nome:</strong>
                    <p>@Html.DisplayFor(model => model.Nome)</p>
                </div>

                <div class="col-md-6">
                    <strong>Sobre:</strong>
                    <p>@Html.DisplayFor(model => model.Sobre)</p>
                </div>

                <div class="col-md-4">
                    <strong>Estágio:</strong>
                    <p>@Html.DisplayFor(model => model.Estagio)</p>
                </div>

                <div class="col-md-4">
                    <strong>Área Construída:</strong>
                    <p>@Html.DisplayFor(model => model.AreaConstruida)</p>
                </div>

                <div class="col-md-4">
                    <strong>Vagas:</strong>
                    <p>@Html.DisplayFor(model => model.VagasTotal)</p>
                </div>

                <div class="col-md-4">
                    <strong>Banheiros:</strong>
                    <p>@Html.DisplayFor(model => model.BanheirosTotal)</p>
                </div>

                <div class="col-md-4">
                    <strong>Dormitórios:</strong>
                    <p>@Html.DisplayFor(model => model.DormitoriosTotal)</p>
                </div>

                <div class="col-md-4">
                    <strong>Suítes:</strong>
                    <p>@Html.DisplayFor(model => model.SuitesTotal)</p>
                </div>
            </div>
        </details>
    </div>

    <!-- CARD: Endereço -->
    <div class="card shadow-sm mb-4">
        <details open>
            <summary class="card-header bg-light">
                <span class="summary-title">Endereço</span>
            </summary>
            <div class="card-body row g-3">
                <div class="col-md-3">
                    <strong>CEP:</strong>
                    <p>@Html.DisplayFor(model => model.Endereco.Cep)</p>
                </div>
                <div class="col-md-5">
                    <strong>Logradouro:</strong>
                    <p>@Html.DisplayFor(model => model.Endereco.Logradouro)</p>
                </div>
                <div class="col-md-2">
                    <strong>Número:</strong>
                    <p>@Html.DisplayFor(model => model.Endereco.Numero)</p>
                </div>
                <div class="col-md-2">
                    <strong>Bairro:</strong>
                    <p>@Html.DisplayFor(model => model.Endereco.Bairro)</p>
                </div>
                <div class="col-md-4">
                    <strong>Complemento:</strong>
                    <p>@Html.DisplayFor(model => model.Endereco.Complemento)</p>
                </div>
                <div class="col-md-6">
                    <strong>Cidade:</strong>
                    <p>@Html.DisplayFor(model => model.Endereco.Cidade)</p>
                </div>
                <div class="col-md-2">
                    <strong>UF:</strong>
                    <p>@Html.DisplayFor(model => model.Endereco.Uf)</p>
                </div>
            </div>
        </details>
    </div>

    <!-- CARD: Unidades -->
    @if (Model.Unidades != null && Model.Unidades.Any())
    {
        <div class="card shadow-sm mb-4">
            <details open>
                <summary class="card-header bg-light d-flex justify-content-between align-items-center">
                    <span class="summary-title flex-grow-1">Unidades do Empreendimento</span>
                </summary>
                <div class="card-body p-0">
                    @await Html.PartialAsync("_tabelaUnidade", Model.Unidades)
                </div>
            </details>
        </div>
    }

    <!-- CARD: Imagens -->
    @if (Model.Arquivos != null && Model.Arquivos.Any())
    {
        <div class="card shadow-sm mb-4">
            <details open>
                <summary class="card-header bg-light d-flex justify-content-between align-items-center">
                    <span class="summary-title flex-grow-1">Imagens</span>
                    @*                     <a asp-controller="Unidade" asp-action="Create" asp-route-empreendimentoId="@Model.Id" class="btn btn-outline-secondary mb-0">
                        + Nova Unidade
                    </a> *@
                </summary>
                <div class="card-body">
                    <div class="horizontal-carousel d-flex overflow-auto py-2">
                        @foreach (var arquivo in Model.Arquivos)
                        {
                            <div class="card shadow-sm me-3" style="min-width: 200px;">
                                <div class="card-img-wrapper">
                                    <img src="@Url.Content("~/" + arquivo.Caminho)"
                                         class="card-img-top rounded"
                                         alt="@arquivo.Tipo"
                                         style="object-fit: cover; height: 150px;" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </details>
        </div>
    }

    <!-- BOTÕES -->
    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Editar</a>
    </div>
</div>
