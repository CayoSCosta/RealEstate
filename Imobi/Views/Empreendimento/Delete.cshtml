@model Imobi.Models.Empreendimento

@{
    ViewData["Title"] = "Excluir Empreendimento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-trash"></i> Excluir Empreendimento</h5>
            <a asp-action="Index" class="btn btn-light btn-sm">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
        </div>

        <div class="card-body">
            <div class="alert alert-warning" role="alert">
                <strong>Atenção!</strong> Esta ação é irreversível. Tem certeza de que deseja excluir este empreendimento?
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Nome</label>
                    <p class="form-control-plaintext">@Model.Nome</p>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Status</label>
                    <p class="form-control-plaintext">
                        @(Model.Status ? "Ativo" : "Inativo")
                    </p>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Área Construída (m²)</label>
                    <p class="form-control-plaintext">@Model.AreaConstruida</p>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Estágio</label>
                    <p class="form-control-plaintext">@Model.Estagio</p>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Banheiros</label>
                    <p class="form-control-plaintext">@Model.BanheirosTotal</p>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Dormitórios</label>
                    <p class="form-control-plaintext">@Model.DormitoriosTotal</p>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Suítes</label>
                    <p class="form-control-plaintext">@Model.SuitesTotal</p>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Vagas</label>
                    <p class="form-control-plaintext">@Model.VagasTotal</p>
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-semibold">Descrição</label>
                    <p class="form-control-plaintext">@Model.Sobre</p>
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-semibold">Endereço</label>
                    <p class="form-control-plaintext">
                        @Model.Endereco?.Logradouro, @Model.Endereco?.Numero -
                        @Model.Endereco?.Bairro - @Model.Endereco?.Cidade / @Model.Endereco?.Uf
                    </p>
                </div>
            </div>

            <hr class="my-4" />

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash"></i> Excluir
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
