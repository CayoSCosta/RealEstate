@model IEnumerable<Imobi.Models.Empreendimento>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<p>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-lg"></i> Novo
    </a>
</p>

<table class="table table-hover">
    <thead class="table-light">
        <tr>
@*             <th>@Html.DisplayNameFor(model => model.Status)</th> *@
            <th>@Html.DisplayNameFor(model => model.Nome)</th>
            <th>@Html.DisplayNameFor(model => model.AreaConstruida)</th>
            <th>@Html.DisplayNameFor(model => model.BanheirosTotal)</th>
            <th>@Html.DisplayNameFor(model => model.DormitoriosTotal)</th>
            <th>@Html.DisplayNameFor(model => model.SuitesTotal)</th>
            <th>@Html.DisplayNameFor(model => model.VagasTotal)</th>
            <th>@Html.DisplayNameFor(model => model.Endereco.Bairro)</th>
            <th>@Html.DisplayNameFor(model => model.Endereco.Logradouro)</th>
            <th>@Html.DisplayNameFor(model => model.Estagio)</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
@*                 <td>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" disabled @(item.Status ? "checked" : "") />
                    </div>
                </td> *@
                <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                <td>@Html.DisplayFor(modelItem => item.AreaConstruida)</td>
                <td>@Html.DisplayFor(modelItem => item.BanheirosTotal)</td>
                <td>@Html.DisplayFor(modelItem => item.DormitoriosTotal)</td>
                <td>@Html.DisplayFor(modelItem => item.SuitesTotal)</td>
                <td>@Html.DisplayFor(modelItem => item.VagasTotal)</td>
                <td>@Html.DisplayFor(modelItem => item.Endereco.Bairro)</td>
                <td>@($"{item.Endereco.Logradouro} nº{item.Endereco.Numero}")</td>
                <td>@Html.DisplayFor(modelItem => item.Estagio)</td>
                <td>
                    <div class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Detalhes">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
