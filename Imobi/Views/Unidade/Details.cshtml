@using Imobi.Models.Empreendimento
@model Unidade

@{
    ViewData["Title"] = "Detalhes da Unidade";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="py-4">
    <h3 class="mb-4">Detalhes da Unidade</h3>

    <!-- CARD: Informações da Unidade -->
    <div class="card shadow-sm mb-4">
        <details open>
            <summary class="card-header bg-light">
                <span class="summary-title">Informações da Unidade</span>
            </summary>
            <div class="card-body row g-3">

                <div class="form-check">
                    <div class="form-check form-switch">
                        <input asp-for="Status" class="form-check-input" disabled type="checkbox" />
                        <label class="form-check-label" asp-for="Status">Ativa</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <strong>Tipo:</strong>
                    <p>@Html.DisplayFor(model => model.Tipo)</p>
                </div>

                <div class="col-md-4">
                    <strong>Dormitórios:</strong>
                    <p>@Html.DisplayFor(model => model.Dormitorios)</p>
                </div>

                <div class="col-md-4">
                    <strong>Suítes:</strong>
                    <p>@Html.DisplayFor(model => model.Suites)</p>
                </div>

                <div class="col-md-4">
                    <strong>Banheiros:</strong>
                    <p>@Html.DisplayFor(model => model.Banheiros)</p>
                </div>

                <div class="col-md-4">
                    <strong>Vagas:</strong>
                    <p>@Html.DisplayFor(model => model.Vagas)</p>
                </div>

                <div class="col-md-4">
                    <strong>Área Construída:</strong>
                    <p>@Html.DisplayFor(model => model.AreaConstruida) m²</p>
                </div>

                <div class="col-md-4">
                    <strong>Valor:</strong>
                    <p>R$ @Html.DisplayFor(model => model.Valor)</p>
                </div>

                <div class="col-md-8">
                    <strong>Empreendimento:</strong>
                    <p>
                        @if (Model.Empreendimento != null)
                        {
                            <a asp-controller="Empreendimento" asp-action="Details" asp-route-id="@Model.Empreendimento.Id">
                                @Model.Empreendimento.Nome
                            </a>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </p>
                </div>
            </div>
        </details>
    </div>

    <!-- CARD: Imagens -->
    @if (Model.Arquivos != null && Model.Arquivos.Any())
    {
        <div class="card shadow-sm mb-4">
            <details open>
                <summary class="card-header bg-light">
                    <span class="summary-title">Imagens da Unidade</span>
                </summary>
                <div class="card-body">
                    <div class="horizontal-carousel d-flex overflow-auto py-2">
                        @foreach (var arquivo in Model.Arquivos)
                        {
                            <div class="card shadow-sm me-3" style="min-width: 200px;">
                                <div class="card-img-wrapper">
                                    <img src="@Url.Content("~/" + arquivo.Caminho)"
                                         class="card-img-top rounded"
                                         alt="@arquivo.Tipo"
                                         style="object-fit: cover; height: 150px;" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </details>
        </div>
    }

    <!-- BOTÕES -->
    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Editar</a>
    </div>
</div>
