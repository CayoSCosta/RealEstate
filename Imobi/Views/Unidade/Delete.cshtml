@model Imobi.Models.Unidade

@{
    ViewData["Title"] = "Excluir Unidade";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_Loader")

<div class="container py-4">

    <!-- TÍTULO -->
    <h3 class="mb-4 text-danger">
        <i class="bi bi-trash"></i> Excluir Unidade
    </h3>

    <!-- ALERTA -->
    <div class="alert alert-warning shadow-sm">
        <strong>Atenção!</strong> Esta ação é irreversível. Tem certeza de que deseja excluir esta unidade?
    </div>

    <!-- CARD: Sobre a Unidade -->
    <div class="card shadow-sm mb-4 border-danger">
        <details open>
            <summary class="card-header bg-light d-flex justify-content-between align-items-center">
                <span class="summary-title flex-grow-1" style="color: #dc3545;">Sobre a Unidade</span>
            </summary>

            <div class="card-body row g-3">
                <div class="col-md-3">
                    <strong>Status:</strong>
                    <div class="form-check mt-1">
                        <input class="form-check-input" type="checkbox" disabled @(Model.Status ? "checked" : "") />
                        <label class="form-check-label">Ativa</label>
                    </div>
                </div>

                <div class="col-md-3">
                    <strong>Tipo:</strong>
                    <p class="form-control-plaintext">@Model.Tipo</p>
                </div>

                <div class="col-md-3">
                    <strong>Dormitórios:</strong>
                    <p class="form-control-plaintext">@Model.Dormitorios</p>
                </div>

                <div class="col-md-3">
                    <strong>Suítes:</strong>
                    <p class="form-control-plaintext">@Model.Suites</p>
                </div>

                <div class="col-md-3">
                    <strong>Banheiros:</strong>
                    <p class="form-control-plaintext">@Model.Banheiros</p>
                </div>

                <div class="col-md-3">
                    <strong>Vagas:</strong>
                    <p class="form-control-plaintext">@Model.Vagas</p>
                </div>

                <div class="col-md-3">
                    <strong>Área Construída:</strong>
                    <p class="form-control-plaintext">@Model.AreaConstruida m²</p>
                </div>

                <div class="col-md-3">
                    <strong>Empreendimento:</strong>
                    <p class="form-control-plaintext">@Model.Empreendimento?.Nome (@Model.Empreendimento?.Id)</p>
                </div>
            </div>
        </details>
    </div>

    <!-- CARD: Valores -->
    <div class="card shadow-sm mb-4 border-danger">
        <details open>
            <summary class="card-header bg-light d-flex justify-content-between align-items-center">
                <span class="summary-title flex-grow-1" style="color: #dc3545;">Valores</span>
            </summary>

            <div class="card-body row g-3">
                <div class="col-md-4">
                    <strong>Valor da Unidade:</strong>
                    <p class="form-control-plaintext">R$ @Model.Valor?.ToString("N2")</p>
                </div>
            </div>
        </details>
    </div>

    <!-- CARD: Imagens (se houver) -->
    @if (Model.Arquivos != null && Model.Arquivos.Any())
    {
        <div class="card shadow-sm mb-4 border-danger">
            <details open>
                <summary class="card-header bg-light d-flex justify-content-between align-items-center">
                    <span class="summary-title flex-grow-1" style="color: #dc3545;">Imagens</span>
                </summary>
                <div class="card-body">
                    <div class="horizontal-carousel d-flex overflow-auto py-2">
                        @foreach (var arquivo in Model.Arquivos)
                        {
                            <div class="card shadow-sm me-3" style="min-width: 180px;">
                                <div class="card-img-wrapper" style="height: 120px; overflow: hidden;">
                                    <img src="@Url.Content("~/" + arquivo.Caminho)" class="card-img-top" alt="@arquivo.Tipo" style="object-fit: cover; height: 100%; width: 100%;" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </details>
        </div>
    }

    <!-- BOTÕES -->
    <form asp-action="Delete" id="form-delete" class="mt-4">
        <input type="hidden" asp-for="Id" />

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-x-circle"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-danger px-4">
                <i class="bi bi-trash"></i> Excluir
            </button>
        </div>
    </form>
</div>

<script>
    const form = document.getElementById("form-delete");

    if (form) {
        form.addEventListener("submit", function (e) {
            Loading.show("Deletando unidade...");
            e.preventDefault();
            setTimeout(() => form.submit(), 2000);
        });
    }
</script>