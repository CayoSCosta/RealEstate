@model IEnumerable<RealEstate.Models.ViewModels.UnidadeViewModel>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h1>Unidades</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Empreendimento.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tipo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dormitorios)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Suites)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Banheiros)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VagasDeGaragem)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AreaConstruida)
            </th>
            <th>
                Ações
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Empreendimento.Nome)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Tipo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Dormitorios)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Suites)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Banheiros)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.VagasDeGaragem)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.AreaConstruida)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1" title="Editar">
                        <i class="bi bi-pencil-square"></i>
                    </a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1" title="Detalhes">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir">
                        <i class="bi bi-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
