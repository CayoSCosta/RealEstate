@model RealEstate.Models.ViewModels.UnidadeViewModel

@{
    ViewData["Title"] = "Editar Unidade";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm rounded-3">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Unidade</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <!-- ComboBox Empreendimento -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="EmpreendimentoId" class="form-label"></label>
                        <select asp-for="EmpreendimentoId" class="form-select" asp-items="ViewBag.Empreendimentos">
                            <option value="">-- Selecione o Empreendimento --</option>
                        </select>
                        <span asp-validation-for="EmpreendimentoId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Tipo" class="form-label"></label>
                        <input asp-for="Tipo" class="form-control" />
                        <span asp-validation-for="Tipo" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Dormitorios" class="form-label"></label>
                        <input asp-for="Dormitorios" class="form-control" />
                        <span asp-validation-for="Dormitorios" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Suites" class="form-label"></label>
                        <input asp-for="Suites" class="form-control" />
                        <span asp-validation-for="Suites" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Banheiros" class="form-label"></label>
                        <input asp-for="Banheiros" class="form-control" />
                        <span asp-validation-for="Banheiros" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="VagasDeGaragem" class="form-label"></label>
                        <input asp-for="VagasDeGaragem" class="form-control" />
                        <span asp-validation-for="VagasDeGaragem" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AreaConstruida" class="form-label"></label>
                        <input asp-for="AreaConstruida" class="form-control" />
                        <span asp-validation-for="AreaConstruida" class="text-danger"></span>
                    </div>
                </div>

                <!-- Mostrar imagens já cadastradas -->
                <h5>Imagens da Unidade</h5>
                @if (Model.Imagens != null && Model.Imagens.Any())
                {
                    <div class="row g-3 mb-3">
                        @foreach (var imagem in Model.Imagens)
                        {
                            <div class="col-12 mb-3">
                                <h6>@imagem.Tipo.ToString()</h6>
                                <div class="row">
                                    @foreach (var versao in imagem.Versoes)
                                    {
                                        <div class="col-md-3 col-sm-4 col-6 mb-2">
                                            <div class="card shadow-sm">
                                                <img src="@Url.Content(versao.Caminho)" class="card-img-top rounded" alt="@imagem.Tipo" />
                                                <div class="card-body text-center">
                                                    <small>@versao.Tamanho (@versao.Extensao)</small>
                                                    <button type="button" class="btn btn-sm btn-danger mt-2">
                                                        <i class="bi bi-trash"></i> Remover
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted">Não tem imagens disponíveis</div>
                }

                <!-- Upload novas imagens -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Adicionar imagens de plantas</label>
                        <input type="file" name="Plantas" class="form-control" multiple />
                    </div>
                </div>


                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Salvar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
