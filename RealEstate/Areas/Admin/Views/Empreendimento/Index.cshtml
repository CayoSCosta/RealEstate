@model IEnumerable<RealEstate.Models.Entities.Empreendimento.Empreendimento>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descricao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AreaConstruidaMin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AreaConstruidaMax)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DormitoriosMin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DormitoriosMax)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BanheirosMin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BanheirosMax)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CriadoPor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CriadoEm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AtualizadoPor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AtualizadoEm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ativo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descricao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AreaConstruidaMin)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AreaConstruidaMax)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DormitoriosMin)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DormitoriosMax)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BanheirosMin)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BanheirosMax)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CriadoPor)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CriadoEm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AtualizadoPor)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AtualizadoEm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ativo)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
