@model IEnumerable<RealEstate.Models.Dtos.EmpreendimentoViewModel>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<!-- DataTables CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">

<h1>Empreendimentos</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table id="table-index" class="table">
    <thead>
        <tr>
            <th>
                Empreendimento
            </th>
            <th>
                Status
            </th>
            <th>
               Bairro
            </th>
            <th>
                Área
            </th>
            <th>
                Dormitórios
            </th>
            <th>
                Banheiro
            </th>
            <th>
                Suíte
            </th>
            <th>
                Garagem
            </th>
            <th>
                Ações
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Nome
                </td>
                <td>
                    @item.Status
                </td>
                <td>
                    @item.Endereco?.Bairro
                </td>
                <td>
                    @($"{item.AreaConstruidaMin}² - {item.AreaConstruidaMax}²")
                </td>
                <td>
                    @($"{item.DormitoriosMin} - {item.DormitoriosMax}")
                </td>
                <td>
                    @($"{item.BanheirosMin} - {item.BanheirosMax}")
                </td>
                <td>
                    @($"{item.SuitesMin} - {item.SuitesMax}")
                </td>
                <td>
                    @($"{item.VagasDeGaragemMin} - {item.VagasDeGaragemMax}")
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1" title="Editar">
                        <i class="bi bi-pencil-square"></i>
                    </a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1" title="Detalhes">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir">
                        <i class="bi bi-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

<!-- DataTables JS -->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script>
    $(document).ready(function () {
        $('#table-index').DataTable();
    });
</script>