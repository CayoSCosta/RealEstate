@model RealEstate.Models.ViewModels.EmpreendimentoViewModel

@{
    ViewData["Title"] = "Editar Empreendimento";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm rounded-3">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Empreendimento</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" enctype="multipart/form-data" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <!-- Informações básicas -->
                    <div class="col-md-6">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label"></label>
                        <input asp-for="Status" class="form-control" />
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Descricao" class="form-label"></label>
                        <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AreaConstruidaMin" class="form-label"></label>
                        <input asp-for="AreaConstruidaMin" class="form-control" />
                        <span asp-validation-for="AreaConstruidaMin" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AreaConstruidaMax" class="form-label"></label>
                        <input asp-for="AreaConstruidaMax" class="form-control" />
                        <span asp-validation-for="AreaConstruidaMax" class="text-danger"></span>
                    </div>

                </div>

                <hr />

                <!-- Mostrar imagens já cadastradas -->
                <h5>Imagens</h5>
@*                 <div class="row g-3 mb-3">
                    @if (Model.Imagens != null && Model.Imagens.Any())
                    {
                        @foreach (var imagem in Model.Imagens)
                        {
                            <div class="col-12 mb-3">
                                <h6>@imagem.Tipo.ToString()</h6>
                                <div class="row">
                                    @foreach (var versao in imagem.Versoes)
                                    {
                                        <div class="col-md-3 col-sm-4 col-6 mb-2">
                                            <div class="card shadow-sm">
                                                <img src="@Url.Content(versao.Caminho)" class="card-img-top rounded" alt="@imagem.Tipo" />
                                                <div class="card-body text-center">
                                                    <small>@versao.Tamanho (@versao.Extensao)</small>
                                                    <button type="button" class="btn btn-sm btn-danger mt-2">
                                                        <i class="bi bi-trash"></i> Remover
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">Não tem imagens disponíveis</div>
                        <hr />
                    }
                </div> *@

                <!-- Upload novas imagens -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Adicionar Imagem de Fachada</label>
                        <input type="file" name="Imagens[0].Imagem" class="form-control" />
                        <input type="hidden" name="Imagens[0].Tipo" value="1" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Adicionar Demais Imagens</label>
                        <input type="file" name="Imagens[1].Imagem" class="form-control" multiple />
                        <input type="hidden" name="Imagens[1].Tipo" value="2" />
                    </div>
                </div>


                <hr />

                <!-- Endereço -->
                <h5>Endereço</h5>
                <div class="row g-3 mb-6">
                    <div class="col-md-2">
                        <label asp-for="Endereco.Cep" class="form-label"></label>
                        <input asp-for="Endereco.Cep" class="form-control" />
                        <span asp-validation-for="Endereco.Cep" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Endereco.Bairro" class="form-label"></label>
                        <input asp-for="Endereco.Bairro" class="form-control" />
                        <span asp-validation-for="Endereco.Bairro" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Endereco.Cidade" class="form-label"></label>
                        <input asp-for="Endereco.Cidade" class="form-control" />
                        <span asp-validation-for="Endereco.Cidade" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Endereco.Uf" class="form-label"></label>
                        <input asp-for="Endereco.Uf" class="form-control" />
                        <span asp-validation-for="Endereco.Uf" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Endereco.Logradouro" class="form-label"></label>
                        <input asp-for="Endereco.Logradouro" class="form-control" />
                        <span asp-validation-for="Endereco.Logradouro" class="text-danger"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Endereco.Numero" class="form-label"></label>
                        <input asp-for="Endereco.Numero" class="form-control" />
                        <span asp-validation-for="Endereco.Numero" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Endereco.Complemento" class="form-label"></label>
                        <input asp-for="Endereco.Complemento" class="form-control" />
                        <span asp-validation-for="Endereco.Complemento" class="text-danger"></span>
                    </div>
                </div>

                <hr />

                <!-- Arquivos -->
                <h5>Arquivos Diversos</h5>
                <div class="col-md-6 mb-3">
                    <input asp-for="Arquivos" type="file" class="form-control" multiple />
                    <span asp-validation-for="Arquivos" class="text-danger"></span>
                </div>
                @if (Model.Arquivos?.Any() == true)
                {
                    <ul class="list-group mb-3">
                        @foreach (var arquivo in Model.Arquivos)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <a href="@arquivo.FileName" target="_blank">@arquivo.FileName</a>
                            </li>
                        }
                    </ul>
                }

                <hr />

                <!-- Ativo -->
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Ativo" />
                    <label class="form-check-label" asp-for="Ativo"></label>
                </div>

                <div class="d-flex justify-content-between mt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save"></i> Salvar
                    </button>
                </div>
            </form>

            <!-- UNIDADES -->
            <hr class="my-4" />
            <h5 class="mb-3"><i class="bi bi-house-door"></i> Unidades</h5>

            @if (Model.Unidades != null && Model.Unidades.Any())
            {
                <table class="table table-striped table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Tipo</th>
                            <th>Dormitórios</th>
                            <th>Suítes</th>
                            <th>Banheiros</th>
                            <th>Vagas</th>
                            <th>Área Construída</th>
                            <th>Ativo</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var unidade in Model.Unidades)
                        {
                            <tr>
                                <td>@unidade.Tipo</td>
                                <td>@unidade.Dormitorios</td>
                                <td>@unidade.Suites</td>
                                <td>@unidade.Banheiros</td>
                                <td>@unidade.VagasDeGaragem</td>
                                <td>@unidade.AreaConstruida</td>
                                <td>
                                    <form asp-action="ToggleUnidadeAtivo" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@unidade.Id" />
                                        <button type="submit" class="btn btn-sm @(unidade.Ativo ? "btn-success" : "btn-danger")">
                                            @(unidade.Ativo ? "Ativo" : "Inativo")
                                        </button>
                                    </form>
                                </td>
                                <td>
                                    <a asp-controller="Unidades" asp-action="Edit" asp-route-id="@unidade.Id" class="btn btn-sm btn-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">Nenhuma unidade cadastrada para este empreendimento.</p>
            }

            <div class="mt-3">
                <a asp-controller="Unidade" asp-action="Create" asp-route-empreendimentoId="@Model.Id" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Adicionar Unidade
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
