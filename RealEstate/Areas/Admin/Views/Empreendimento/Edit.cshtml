@model RealEstate.Models.ViewModels.EmpreendimentoViewModel

@{
    ViewData["Title"] = "Editar Empreendimento";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm rounded-3">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Empreendimento</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Descricao" class="form-label"></label>
                        <input asp-for="Descricao" class="form-control" />
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AreaConstruidaMin" class="form-label"></label>
                        <input asp-for="AreaConstruidaMin" class="form-control" />
                        <span asp-validation-for="AreaConstruidaMin" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AreaConstruidaMax" class="form-label"></label>
                        <input asp-for="AreaConstruidaMax" class="form-control" />
                        <span asp-validation-for="AreaConstruidaMax" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DormitoriosMin" class="form-label"></label>
                        <input asp-for="DormitoriosMin" class="form-control" />
                        <span asp-validation-for="DormitoriosMin" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DormitoriosMax" class="form-label"></label>
                        <input asp-for="DormitoriosMax" class="form-control" />
                        <span asp-validation-for="DormitoriosMax" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="BanheirosMin" class="form-label"></label>
                        <input asp-for="BanheirosMin" class="form-control" />
                        <span asp-validation-for="BanheirosMin" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="BanheirosMax" class="form-label"></label>
                        <input asp-for="BanheirosMax" class="form-control" />
                        <span asp-validation-for="BanheirosMax" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3 form-check" style="margin-left: 10px;">
                        <input class="form-check-input" asp-for="Ativo" />
                        <label class="form-check-label" asp-for="Ativo"></label>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Salvar
                    </button>
                </div>
            </form>

            <!-- TABELA DE UNIDADES -->
            <hr class="my-4" />
            <h5 class="mb-3"><i class="bi bi-house-door"></i> Unidades</h5>

            @if (Model.Unidades != null && Model.Unidades.Any())
            {
                <table class="table table-striped table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Tipo</th>
                            <th>Dormitórios</th>
                            <th>Suítes</th>
                            <th>Banheiros</th>
                            <th>Vagas</th>
                            <th>Área Construída</th>
                            <th>Ativo</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var unidade in Model.Unidades)
                        {
                            <tr>
                                <td>@unidade.Tipo</td>
                                <td>@unidade.Dormitorios</td>
                                <td>@unidade.Suites</td>
                                <td>@unidade.Banheiros</td>
                                <td>@unidade.VagasDeGaragem</td>
                                <td>@unidade.AreaConstruida</td>
                                <td>
                                    <form asp-action="ToggleUnidadeAtivo" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@unidade.Id" />
                                        <button type="submit" class="btn btn-sm @(unidade.Ativo ? "btn-success" : "btn-danger")">
                                            @(unidade.Ativo ? "Ativo" : "Inativo")
                                        </button>
                                    </form>
                                </td>
                                <td>
                                    <a asp-controller="Unidades" asp-action="Edit" asp-route-id="@unidade.Id" class="btn btn-sm btn-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">Nenhuma unidade cadastrada para este empreendimento.</p>
            }

            <div class="mt-3">
                <a asp-controller="Unidade" asp-action="Create" asp-route-empreendimentoId="@Model.Id" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Adicionar Unidade
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
