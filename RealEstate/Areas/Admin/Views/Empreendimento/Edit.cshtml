@model RealEstate.Models.Entities.Empreendimento.Empreendimento

@{
    ViewData["Title"] = "Editar Empreendimento";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm rounded-3">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Empreendimento</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Descricao" class="form-label"></label>
                        <input asp-for="Descricao" class="form-control" />
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AreaConstruidaMin" class="form-label"></label>
                        <input asp-for="AreaConstruidaMin" class="form-control" />
                        <span asp-validation-for="AreaConstruidaMin" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AreaConstruidaMax" class="form-label"></label>
                        <input asp-for="AreaConstruidaMax" class="form-control" />
                        <span asp-validation-for="AreaConstruidaMax" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DormitoriosMin" class="form-label"></label>
                        <input asp-for="DormitoriosMin" class="form-control" />
                        <span asp-validation-for="DormitoriosMin" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DormitoriosMax" class="form-label"></label>
                        <input asp-for="DormitoriosMax" class="form-control" />
                        <span asp-validation-for="DormitoriosMax" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="BanheirosMin" class="form-label"></label>
                        <input asp-for="BanheirosMin" class="form-control" />
                        <span asp-validation-for="BanheirosMin" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="BanheirosMax" class="form-label"></label>
                        <input asp-for="BanheirosMax" class="form-control" />
                        <span asp-validation-for="BanheirosMax" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3 form-check" style="margin-left: 10px;">
                        <input class="form-check-input" asp-for="Ativo" />
                        <label class="form-check-label" asp-for="Ativo"></label>
                    </div>

                    <!-- Campos de auditoria como somente leitura -->
@*                     <div class="col-md-6 mb-3">
                        <label asp-for="CriadoPor" class="form-label"></label>
                        <input asp-for="CriadoPor" class="form-control" readonly />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CriadoEm" class="form-label"></label>
                        <input asp-for="CriadoEm" class="form-control" readonly />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="AtualizadoPor" class="form-label"></label>
                        <input asp-for="AtualizadoPor" class="form-control" readonly />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="AtualizadoEm" class="form-label"></label>
                        <input asp-for="AtualizadoEm" class="form-control" readonly />
                    </div> *@
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Salvar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
